{
  "headers": [
    {
      "source": "/fortune/delivery/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/room", "destination": "/room.html" },
    { "source": "/room/(.*)", "destination": "/room.html" },
    { "source": "/auth", "destination": "/index.html" },
    { "source": "/exams", "destination": "/index.html" },
    { "source": "/viewer", "destination": "/index.html" },
    { "source": "/report", "destination": "/index.html" },
    { "source": "/wrongnote", "destination": "/index.html" },
    { "source": "/payment", "destination": "/index.html" },
    { "source": "/academy-preview", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/audit/(.*)", "destination": "/index.html" }
  ]
}
