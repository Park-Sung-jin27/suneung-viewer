    "2023_06_geo_28": {
      "id": "2023_06_geo_28",
      "status": "verified_internal_candidate",
      "exam": "2023학년도 6월 모의평가 수학 기하",
      "questionNumber": 28,
      "answer": "1",
      "answerMark": "①",
      "summary": "직선 위의 점을 (x,2x-3)으로 두고 거리의 차를 미분합니다. x=3에서 미분계수가 0이라는 조건을 정리하면 c²=27/2이므로 c=3√6/2입니다.",
      "approach": "움직이는 점의 한 좌표로 두 거리를 나타내고, 최대점에서 거리 차의 미분계수가 0임을 사용합니다.",
      "concepts": [
        "두 점 사이의 거리",
        "최댓값과 미분계수"
      ],
      "steps": [
        {
          "title": "거리의 차를 함수로 나타내기",
          "expression": "F(x)=\\sqrt{(x+c)^2+(2x-3)^2}-\\sqrt{(x-c)^2+(2x-3)^2}",
          "explanation": "P=(x,2x-3), B=(-c,0), A=(c,0)을 거리 공식에 대입합니다."
        },
        {
          "title": "최대점의 미분 조건 세우기",
          "expression": "F'(3)=\\frac{9+c}{\\sqrt{(3+c)^2+9}}-\\frac{9-c}{\\sqrt{(3-c)^2+9}}=0",
          "explanation": "최대가 되는 점 P가 (3,3)이므로 x=3에서 접선의 기울기는 0입니다."
        },
        {
          "title": "식을 제곱해 정리하기",
          "expression": "(9+c)^2(c^2-6c+18)=(9-c)^2(c^2+6c+18)",
          "explanation": "등식이 성립하려면 9-c도 양수여야 하므로 c<9입니다. 양변이 양수인 상태에서 제곱합니다."
        },
        {
          "title": "c 결정하기",
          "expression": "12c(2c^2-27)=0\\Rightarrow c^2=\\frac{27}{2}",
          "explanation": "c>0이므로 c=0은 제외합니다."
        },
        {
          "title": "양의 값 선택하기",
          "expression": "c=\\sqrt{\\frac{27}{2}}=\\frac{3\\sqrt6}{2}",
          "explanation": "문제에서 c가 양수라고 주어졌습니다."
        }
      ],
      "correctReason": "c=3√6/2이므로 정답은 ①입니다.",
      "commonMistake": "PB-PA를 미분할 때 y=2x-3의 변화율 2를 빼먹지 마세요. 각 거리의 미분 분자에 2(2x-3)가 추가됩니다.",
