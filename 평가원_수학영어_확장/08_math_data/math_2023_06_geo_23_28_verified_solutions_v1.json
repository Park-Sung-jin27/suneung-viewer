    "2023_06_geo_24": {
      "id": "2023_06_geo_24",
      "status": "verified_internal_candidate",
      "exam": "2023학년도 6월 모의평가 수학 기하",
      "questionNumber": 24,
      "answer": "2",
      "answerMark": "②",
      "summary": "주축 길이 2a=6에서 a=3이고, 점근선 기울기 b/a=2에서 b=6입니다. c²=a²+b²이므로 초점 사이 거리는 6√5입니다.",
      "approach": "쌍곡선의 주축, 점근선, 초점 공식에 주어진 수치를 차례로 대입합니다.",
      "concepts": [
        "쌍곡선의 점근선",
        "쌍곡선의 초점"
      ],
      "steps": [
        {
          "title": "a 구하기",
          "expression": "2a=6\\Rightarrow a=3",
          "explanation": "x축이 주축인 쌍곡선의 주축 길이는 2a입니다."
        },
        {
          "title": "b 구하기",
          "expression": "\\frac ba=2\\Rightarrow b=6",
          "explanation": "점근선 y=(b/a)x의 기울기가 2입니다."
        },
        {
          "title": "초점 사이 거리 구하기",
          "expression": "c=\\sqrt{a^2+b^2}=3\\sqrt5,\\quad 2c=6\\sqrt5",
          "explanation": "두 초점은 (±c,0)이므로 사이 거리는 2c입니다."
        }
      ],
      "correctReason": "두 초점 사이의 거리는 6√5이므로 정답은 ②입니다.",
      "commonMistake": "c²=a²-b²를 사용하지 마세요. x²/a²-y²/b²=1인 쌍곡선에서는 c²=a²+b²입니다.",
      "verification": {
        "problemPage": 17,
        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
    },
    "2023_06_geo_25": {
      "id": "2023_06_geo_25",
      "status": "verified_internal_candidate",
      "exam": "2023학년도 6월 모의평가 수학 기하",
      "questionNumber": 25,
      "answer": "2",
      "answerMark": "②",
      "summary": "두 직선의 방향벡터를 (4,3), (1,-3)으로 잡고 내적의 절댓값을 사용하면 cosθ=√10/10입니다.",
      "approach": "대칭식에서 방향벡터를 읽고 두 벡터 사이 예각의 코사인을 내적으로 계산합니다.",
      "concepts": [
        "직선의 방향벡터",
        "벡터의 내적"
      ],
      "steps": [
        {
          "title": "방향벡터 정하기",
          "expression": "\\vec u=(4,3),\\quad\\vec v=(1,-3)",
          "explanation": "첫 직선의 매개변수 증가량은 (4,3)이고, 둘째 식은 x-1=t, 2-y=3t로 둘 수 있습니다."
        },
        {
          "title": "내적과 크기 구하기",
          "expression": "\\vec u\\cdot\\vec v=-5,\\quad|\\vec u|=5,\\quad|\\vec v|=\\sqrt{10}",
          "explanation": "문제는 예각을 묻기 때문에 내적의 절댓값을 사용합니다."
        },
        {
          "title": "코사인 계산하기",
          "expression": "\\cos\\theta=\\frac{|\\vec u\\cdot\\vec v|}{|\\vec u||\\vec v|}=\\frac{5}{5\\sqrt{10}}=\\frac{\\sqrt{10}}{10}",
          "explanation": "분모를 유리화해 선택지와 같은 꼴로 만듭니다."
        }
      ],
      "correctReason": "cosθ=√10/10이므로 정답은 ②입니다.",
      "commonMistake": "내적 -5를 그대로 사용해 음수로 답하지 마세요. 두 직선이 이루는 예각의 코사인이므로 절댓값을 취합니다.",
      "verification": {
