        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
    },
    "2022_06_cal_27": {
      "id": "2022_06_cal_27",
      "status": "verified_internal_candidate",
      "exam": "2022학년도 6월 모의평가 수학 미적분",
      "questionNumber": 27,
      "answer": 4,
      "answerMark": "④",
      "summary": "eˣ/(sin x)의 두 번째 양의 구간 최솟값에서 접점 하나가 생겨 전체 양의 근이 3개가 되므로 k=√2e^(9π/4)입니다.",
      "approach": "sin x가 양수인 각 구간에서 eˣ/(sin x)의 최소를 구하고, 수평선 y=k와 만나는 횟수를 구간별로 셉니다.",
      "concepts": [
        "초월방정식의 실근",
        "함수의 최솟값",
        "미분을 이용한 교점 개수"
      ],
      "steps": [
        {
          "title": "근이 가능한 구간 찾기",
          "expression": "e^x=k\\sin x \\Rightarrow h(x)=\\frac{e^x}{\\sin x}=k,\\quad 2m\\pi<x<(2m+1)\\pi",
          "explanation": "eˣ과 k가 양수이므로 sin x가 양수인 구간에서만 근이 생깁니다."
        },
        {
          "title": "각 구간의 최솟값 구하기",
          "expression": "\\frac{h'(x)}{h(x)}=1-\\cot x=0 \\Rightarrow x=2m\\pi+\\frac\\pi4",
          "explanation": "각 양의 구간에서 h는 양 끝에서 무한대로 가고 이 점에서 유일한 최솟값을 가집니다."
        },
        {
          "title": "구간별 최소 높이 계산하기",
          "expression": "h_{\\min,m}=\\sqrt2e^{2m\\pi+\\pi/4}",
          "explanation": "sin(π/4)=√2/2를 대입합니다."
        },
        {
          "title": "양의 근 세 개 만들기",
          "expression": "k=h_{\\min,1}=\\sqrt2e^{2\\pi+\\pi/4}=\\sqrt2e^{9\\pi/4}",
          "explanation": "첫 번째 양의 구간에서는 두 교점, 두 번째 구간에서는 접하는 한 교점, 이후 구간에서는 교점이 없어 총 세 개가 됩니다."
        }
      ],
      "correctReason": "k=√2e^(9π/4)이므로 선지 ④가 정답입니다.",
      "commonMistake": "두 번째 구간의 중앙 5π/2가 아니라 h의 미분값이 0인 9π/4에서 접합니다.",
