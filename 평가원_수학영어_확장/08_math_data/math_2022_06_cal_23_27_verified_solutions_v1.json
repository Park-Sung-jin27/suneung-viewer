    "2022_06_cal_24": {
      "id": "2022_06_cal_24",
      "status": "verified_internal_candidate",
      "exam": "2022학년도 6월 모의평가 수학 미적분",
      "questionNumber": 24,
      "answer": 2,
      "answerMark": "②",
      "summary": "t=0에서 dx/dt=1, dy/dt=1이므로 dy/dx=1입니다.",
      "approach": "매개변수 곡선의 미분 공식 (dy/dt)/(dx/dt)를 사용합니다.",
      "concepts": [
        "매개변수 미분",
        "지수함수의 미분",
        "삼각함수의 미분"
      ],
      "steps": [
        {
          "title": "각 좌표를 t로 미분하기",
          "expression": "\\frac{dx}{dt}=e^t-\\sin t,\\quad\\frac{dy}{dt}=\\cos t",
          "explanation": "x와 y를 각각 매개변수 t에 대해 미분합니다."
        },
        {
          "title": "t=0에서 기울기 계산하기",
          "expression": "\\left.\\frac{dy}{dx}\\right|_{t=0}=\\frac{\\cos0}{e^0-\\sin0}=\\frac11=1",
          "explanation": "dx/dt가 0이 아니므로 두 미분값의 비가 곡선의 기울기입니다."
        }
      ],
      "correctReason": "dy/dx=1이므로 선지 ②가 정답입니다.",
      "commonMistake": "dy/dx를 dy/dt만으로 계산하지 말고 반드시 dx/dt로 나눠야 합니다.",
