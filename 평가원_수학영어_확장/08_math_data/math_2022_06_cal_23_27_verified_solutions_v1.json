        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
    },
    "2022_06_cal_26": {
      "id": "2022_06_cal_26",
      "status": "verified_internal_candidate",
      "exam": "2022학년도 6월 모의평가 수학 미적분",
      "questionNumber": 26,
      "answer": 3,
      "answerMark": "③",
      "summary": "다음 부채꼴의 반지름은 매번 √2/2배가 되고, 색칠한 넓이의 무한등비급수 합은 π/4입니다.",
      "approach": "첫 두 중심의 좌표로 반지름비를 구한 뒤, 각 색칠 영역의 넓이가 반지름 제곱에 비례함을 이용합니다.",
      "concepts": [
        "삼각함수",
        "부채꼴의 넓이",
        "무한등비급수"
      ],
      "steps": [
        {
          "title": "두 번째 반지름 구하기",
          "expression": "O_2=(\\cos75^\\circ,\\sin75^\\circ),\\quad A_2=(\\sin75^\\circ,\\sin75^\\circ)",
          "explanation": "O₁A₁을 x축으로 두면 O₁B₁은 45도 직선 y=x이고, A₂는 O₂를 지나는 수평선과의 교점입니다."
        },
        {
          "title": "반지름비 계산하기",
          "expression": "\\frac{r_2}{r_1}=\\sin75^\\circ-\\cos75^\\circ=\\frac{\\sqrt2}{2}",
          "explanation": "같은 모양이 반복되므로 이후 반지름도 매번 √2/2배가 됩니다."
        },
        {
          "title": "한 색칠 영역의 넓이 쓰기",
          "expression": "A_n=\\frac12r_n^2\\cdot\\frac\\pi4=\\frac\\pi8\\left(\\frac12\\right)^{n-1}",
          "explanation": "색칠된 부채꼴의 중심각은 항상 π/4이고 반지름 제곱비는 1/2입니다."
        },
        {
          "title": "누적 넓이의 극한 구하기",
          "expression": "\\lim_{n\\to\\infty}S_n=\\frac\\pi8\\sum_{j=0}^{\\infty}\\left(\\frac12\\right)^j=\\frac\\pi8\\cdot2=\\frac\\pi4",
          "explanation": "겹치지 않는 색칠 영역들의 넓이를 무한등비급수로 더합니다."
        }
      ],
      "correctReason": "넓이의 극한이 π/4이므로 선지 ③이 정답입니다.",
      "commonMistake": "반지름비 √2/2를 그대로 넓이의 공비로 쓰면 안 됩니다. 넓이는 반지름의 제곱에 비례하므로 공비는 1/2입니다.",
      "verification": {
