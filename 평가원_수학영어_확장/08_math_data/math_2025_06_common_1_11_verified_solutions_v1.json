    "2025_06_common_2": {
      "id": "2025_06_common_2",
      "status": "verified_internal_candidate",
      "exam": "2025학년도 6월 모의평가 수학 공통",
      "questionNumber": 2,
      "answer": "5",
      "answerMark": "⑤",
      "summary": "주어진 극한은 f'(2)이므로 값은 5입니다.",
      "approach": "미분계수의 정의를 알아보고 도함수를 구합니다.",
      "concepts": ["미분계수", "다항함수의 미분"],
      "steps": [
        {
          "title": "정의 확인",
          "expression": "\\lim_{h\\to0}\\frac{f(2+h)-f(2)}h=f'(2)",
          "explanation": "식은 x=2에서의 미분계수 정의입니다."
        },
        {
          "title": "도함수",
          "expression": "f'(x)=2x+1",
          "explanation": "x²+x+2를 항별로 미분합니다."
        },
        {
          "title": "대입",
          "expression": "f'(2)=2\\cdot2+1=5",
          "explanation": "정답은 ⑤입니다."
        }
      ],
      "correctReason": "극한식이 미분계수 정의와 정확히 일치합니다.",
      "commonMistake": "f(2)의 함수값을 묻는 문제로 읽지 마세요.",
