    "2025_09_common_13": {
      "id": "2025_09_common_13",
      "status": "verified_internal_candidate",
      "exam": "2025학년도 9월 모의평가 수학 공통",
      "questionNumber": 13,
      "answer": "4",
      "answerMark": "④",
      "summary": "함수의 대칭성과 A=2B를 합치면 0부터 k까지의 정적분이 0이고 k=6입니다.",
      "approach": "양쪽 넓이를 모두 계산하지 않고 우함수의 대칭으로 하나의 정적분 조건을 만듭니다.",
      "concepts": ["정적분과 넓이", "우함수의 대칭"],
      "steps": [
        {
          "title": "대칭 이용",
          "expression": "f(-x)=f(x),\\qquad A=2\\int_0^Q f(x)\\,dx",
          "explanation": "P와 Q는 y축에 대칭이고 A는 양쪽 넓이의 합입니다."
        },
        {
          "title": "넓이 조건",
          "expression": "A=2B\\Rightarrow \\int_0^k(-x^2+2x+6)\\,dx=0",
          "explanation": "Q 이후의 음의 부분 넓이를 합치면 전체 부호 있는 넓이가 0이 됩니다."
        },
        {
          "title": "방정식 풀기",
          "expression": "-\\frac{k^3}{3}+k^2+6k=-\\frac{k(k+3)(k-6)}3=0",
          "explanation": "k>4이므로 가능한 해는 6입니다."
        }
      ],
      "correctReason": "넓이는 양수로 해석하되, A=2B를 옮기면 부호 있는 정적분 조건으로 정확히 바뀝니다. 따라서 정답은 ④입니다.",
      "commonMistake": "Q 이후 f(x)<0인 구간의 넓이는 -∫f로 계산해야 합니다.",
      "verification": {
        "problemPage": 5,
        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
