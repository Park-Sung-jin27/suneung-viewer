    "2025_09_common_14": {
      "id": "2025_09_common_14",
      "status": "verified_internal_candidate",
      "exam": "2025학년도 9월 모의평가 수학 공통",
      "questionNumber": 14,
      "answer": "5",
      "answerMark": "⑤",
      "summary": "기울기와 거리 조건으로 Bₙ의 y좌표를 구하면 x₁+x₂+x₃=170/7입니다.",
      "approach": "두 점의 좌표 차를 먼저 결정하고, 지수함수와 로그함수의 y=x 대칭을 사용합니다.",
      "concepts": ["지수·로그함수의 대칭", "두 점 사이의 거리"],
      "steps": [
        {
          "title": "좌표 차",
          "expression": "\\Delta y=3\\Delta x,\\quad (\\Delta x)^2+(\\Delta y)^2=10n^2\\Rightarrow \\Delta x=n,\\ \\Delta y=3n",
          "explanation": "기울기가 양수이고 Aₙ의 x좌표가 더 작으므로 두 차는 양수입니다."
        },
        {
          "title": "B의 높이",
          "expression": "2^{b_n}-2^{b_n-n}=3n\\Rightarrow 2^{b_n}=\\frac{3n\\,2^n}{2^n-1}",
          "explanation": "aₙ=bₙ-n을 지수함수의 두 y좌표 차에 대입합니다."
        },
        {
          "title": "대칭으로 xₙ 결정",
          "expression": "x_n=2^{b_n}=\\frac{3n\\,2^n}{2^n-1}",
          "explanation": "원의 중심이 y=x 위에 있으므로 원도 y=x 대칭이고, 로그 곡선의 큰 x좌표는 Bₙ의 y좌표와 같습니다."
        },
        {
          "title": "합",
          "expression": "x_1+x_2+x_3=6+8+\\frac{72}{7}=\\frac{170}{7}",
          "explanation": "정답은 ⑤입니다."
        }
      ],
      "correctReason": "AₙBₙ의 좌표 차와 역함수 대칭을 사용해 원의 방정식을 직접 구하지 않아도 됩니다. 따라서 정답은 ⑤입니다.",
      "commonMistake": "기울기 3만으로 x좌표 차를 3n으로 두지 마세요. 거리 조건까지 함께 써야 Δx=n입니다.",
      "verification": {
