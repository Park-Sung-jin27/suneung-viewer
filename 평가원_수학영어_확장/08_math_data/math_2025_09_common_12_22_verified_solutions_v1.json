    "2025_09_common_12": {
      "id": "2025_09_common_12",
      "status": "verified_internal_candidate",
      "exam": "2025학년도 9월 모의평가 수학 공통",
      "questionNumber": 12,
      "answer": "2",
      "answerMark": "②",
      "summary": "공차는 2, 첫째항은 -4이며 b₁부터 b₉까지의 합은 -20입니다.",
      "approach": "교대합 bₙ을 짝수 번째와 홀수 번째로 나누어 일반식으로 정리합니다.",
      "concepts": ["등차수열", "교대합"],
      "steps": [
        {
          "title": "공차 구하기",
          "expression": "b_2=a_1-a_2=-d=-2\\Rightarrow d=2",
          "explanation": "등차수열의 연속 두 항의 차를 이용합니다."
        },
        {
          "title": "첫째항 구하기",
          "expression": "b_3=a_3-2,\\ b_7=a_7-6,\\ b_3+b_7=2a_1+8=0\\Rightarrow a_1=-4",
          "explanation": "공차 2를 넣어 b₃+b₇ 조건을 정리합니다."
        },
        {
          "title": "교대합 일반식",
          "expression": "b_{2n}=-2n,\\qquad b_{2n-1}=2n-6",
          "explanation": "짝수 번째는 n개의 차 -d를, 홀수 번째는 마지막 홀수항을 남겨 묶습니다."
        },
        {
          "title": "첫 9항의 합",
          "expression": "\\sum_{n=1}^{9}b_n=\\sum_{n=1}^{5}(2n-6)+\\sum_{n=1}^{4}(-2n)=-20",
          "explanation": "정답은 ②입니다."
        }
      ],
      "correctReason": "항을 하나씩 나열한 계산과 짝·홀 일반식 계산이 모두 -20으로 일치합니다. 따라서 정답은 ②입니다.",
      "commonMistake": "bₙ은 aₙ 하나가 아니라 a₁부터 aₙ까지 부호가 번갈아 붙는 합입니다.",
