    "2023_06_common_18": {
      "id": "2023_06_common_18",
      "status": "verified_internal_candidate",
      "exam": "2023학년도 6월 모의평가 수학 공통",
      "questionNumber": 18,
      "answer": "3",
      "answerMark": null,
      "summary": "1부터 10까지의 합을 사용하면 220+10a=250이므로 a=3입니다.",
      "approach": "시그마 안의 4k와 상수 a를 각각 합산합니다.",
      "concepts": [
        "시그마의 선형성",
        "자연수의 합"
      ],
      "steps": [
        {
          "title": "합을 두 부분으로 나누기",
          "expression": "\\sum_{k=1}^{10}(4k+a)=4\\sum_{k=1}^{10}k+10a",
          "explanation": "상수 a는 모두 10번 더해집니다."
        },
        {
          "title": "자연수의 합 계산하기",
          "expression": "4\\cdot\\frac{10\\cdot11}{2}+10a=220+10a",
          "explanation": "1부터 10까지의 합은 55입니다."
        },
        {
          "title": "a 구하기",
          "expression": "220+10a=250\\Rightarrow a=3",
          "explanation": "양변에서 220을 빼고 10으로 나눕니다."
        }
      ],
      "correctReason": "자연수의 합을 적용한 식 220+10a=250을 풀면 a=3입니다.",
      "commonMistake": "상수 a를 한 번만 더하지 마세요. k가 1부터 10까지 변하므로 a도 10번 더해집니다.",
      "verification": {
