    "2023_06_common_1": {
      "id": "2023_06_common_1",
      "status": "verified_internal_candidate",
      "exam": "2023학년도 6월 모의평가 수학 공통",
      "questionNumber": 1,
      "answer": 1,
      "answerMark": "①",
      "summary": "두 인수를 각각 2의 거듭제곱으로 바꾸면 4와 1/4의 곱이므로 값은 1입니다.",
      "approach": "밑을 2로 통일하여 지수법칙을 적용합니다.",
      "concepts": [
        "거듭제곱의 계산",
        "분수 지수와 음의 지수"
      ],
      "steps": [
        {
          "title": "첫 번째 인수 계산하기",
          "expression": "(-\\sqrt2)^4=((\\sqrt2)^2)^2=2^2=4",
          "explanation": "짝수 거듭제곱이므로 음의 부호는 사라집니다."
        },
        {
          "title": "두 번째 인수 계산하기",
          "expression": "8^{-2/3}=(2^3)^{-2/3}=2^{-2}=\\frac14",
          "explanation": "거듭제곱의 거듭제곱에서는 지수를 곱합니다."
        },
        {
          "title": "두 값 곱하기",
          "expression": "4\\times\\frac14=1",
          "explanation": "전체 식의 값은 1입니다."
        }
      ],
      "correctReason": "계산값이 1이므로 선택지 ①이 정답입니다.",
      "commonMistake": "음의 지수는 값 전체에 음수를 붙이는 뜻이 아닙니다. 역수를 취한 뒤 양의 지수로 계산합니다.",
      "verification": {
        "problemPage": 1,
        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
    },
    "2023_06_common_2": {
      "id": "2023_06_common_2",
      "status": "verified_internal_candidate",
      "exam": "2023학년도 6월 모의평가 수학 공통",
      "questionNumber": 2,
      "answer": 2,
      "answerMark": "②",
      "summary": "주어진 극한은 f의 x=2에서의 미분계수이므로 f'(2)=12입니다.",
      "approach": "극한식을 미분계수의 정의로 바로 읽습니다.",
      "concepts": [
        "미분계수의 정의",
        "다항함수의 미분"
      ],
      "steps": [
        {
          "title": "미분계수 형태 확인하기",
          "expression": "\\lim_{h\\to0}\\frac{f(2+h)-f(2)}h=f'(2)",
          "explanation": "x=2에서 증가량 h를 사용한 미분계수의 정의와 같습니다."
        },
        {
          "title": "도함수 구하기",
          "expression": "f(x)=x^3+9\\Rightarrow f'(x)=3x^2",
          "explanation": "상수항 9의 도함수는 0입니다."
        },
        {
          "title": "x=2 대입하기",
          "expression": "f'(2)=3\\cdot2^2=12",
          "explanation": "극한값은 12입니다."
        }
      ],
      "correctReason": "f'(2)=12이므로 선택지 ②가 정답입니다.",
      "commonMistake": "f(2)를 구하는 문제가 아닙니다. 분모 h와 f(2+h)-f(2)의 구조를 보고 미분계수임을 먼저 확인하세요.",
      "verification": {
        "problemPage": 1,
        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
    },
    "2023_06_common_3": {
      "id": "2023_06_common_3",
      "status": "verified_internal_candidate",
      "exam": "2023학년도 6월 모의평가 수학 공통",
      "questionNumber": 3,
      "answer": 4,
      "answerMark": "④",
      "summary": "제2사분면이므로 cosθ=-2/3이고, sin²θ=5/9이어서 합은 -1/9입니다.",
      "approach": "제곱값에서 크기를 구한 뒤 사분면 조건으로 cosθ의 부호를 결정합니다.",
      "concepts": [
        "삼각함수의 부호",
        "삼각함수의 기본 관계"
      ],
      "steps": [
        {
          "title": "cosθ의 부호 정하기",
          "expression": "\\frac\\pi2<\\theta<\\pi,\\quad\\cos^2\\theta=\\frac49\\Rightarrow\\cos\\theta=-\\frac23",
          "explanation": "제2사분면에서는 코사인이 음수입니다."
        },
        {
          "title": "sin²θ 구하기",
          "expression": "\\sin^2\\theta=1-\\cos^2\\theta=1-\\frac49=\\frac59",
          "explanation": "sin²θ+cos²θ=1을 사용합니다."
        },
        {
          "title": "요구한 값 계산하기",
          "expression": "\\sin^2\\theta+\\cos\\theta=\\frac59-\\frac23=-\\frac19",
          "explanation": "공통분모 9로 계산합니다."
        }
      ],
      "correctReason": "값이 -1/9이므로 선택지 ④가 정답입니다.",
      "commonMistake": "cos²θ=4/9에서 cosθ를 항상 2/3으로 두지 마세요. 사분면에 따라 부호가 달라집니다.",
      "verification": {
        "problemPage": 1,
        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
    },
    "2023_06_common_5": {
      "id": "2023_06_common_5",
      "status": "verified_internal_candidate",
      "exam": "2023학년도 6월 모의평가 수학 공통",
      "questionNumber": 5,
      "answer": 3,
      "answerMark": "③",
      "summary": "양의 공비 r에 대해 r(1+r)=6이므로 r=2이고, a₆+a₇=24입니다.",
      "approach": "첫째항과 공비로 두 조건을 표현해 공비를 먼저 결정합니다.",
      "concepts": [
        "등비수열의 일반항",
        "공비 결정"
      ],
      "steps": [
        {
          "title": "공비 방정식 세우기",
          "expression": "a_2+a_3=\\frac14r+\\frac14r^2=\\frac32\\Rightarrow r(r+1)=6",
          "explanation": "aₙ=a₁rⁿ⁻¹을 사용합니다."
        },
        {
          "title": "양의 공비 선택하기",
          "expression": "r^2+r-6=0\\Rightarrow(r-2)(r+3)=0",
          "explanation": "모든 항이 양수이므로 공비는 r=2입니다."
        },
        {
          "title": "a₆+a₇ 계산하기",
          "expression": "a_6+a_7=\\frac14\\cdot2^5+\\frac14\\cdot2^6=8+16=24",
          "explanation": "각 항을 직접 계산하여 더합니다."
        }
      ],
      "correctReason": "a₆+a₇=24이므로 선택지 ③이 정답입니다.",
      "commonMistake": "방정식의 다른 근 r=-3은 조건을 만족하지 않습니다. 첫째항이 양수일 때 음의 공비면 항의 부호가 번갈아 바뀝니다.",
      "verification": {
        "problemPage": 2,
        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
    },
    "2023_06_common_6": {
      "id": "2023_06_common_6",
      "status": "verified_internal_candidate",
      "exam": "2023학년도 6월 모의평가 수학 공통",
      "questionNumber": 6,
      "answer": 5,
      "answerMark": "⑤",
      "summary": "두 경계점에서 절댓값 함수가 이어지는 조건을 적용하면 a+b=11/3입니다.",
      "approach": "x=-1과 x=3에서 왼쪽 값과 오른쪽 값이 같도록 연속 조건을 각각 세웁니다.",
      "concepts": [
        "구간별 함수의 연속",
        "절댓값 방정식"
      ],
      "steps": [
        {
          "title": "x=-1에서 연속 조건 세우기",
          "expression": "|a-1|=1",
          "explanation": "왼쪽 구간의 값은 1이고 가운데 식의 극한은 |a-1|입니다."
        },
        {
          "title": "a 결정하기",
          "expression": "|a-1|=1,\\ a>0\\quad\\Rightarrow\\quad a=2",
          "explanation": "절댓값 방정식의 두 후보 중 양수 조건을 만족하는 값을 선택합니다."
        },
        {
          "title": "x=3에서 b 결정하기",
          "expression": "|3b-2|=3,\\ b>0\\quad\\Rightarrow\\quad b=\\frac53",
          "explanation": "가운데 구간과 오른쪽 구간의 값이 같아야 하므로 같은 방식으로 b를 구합니다."
        },
        {
          "title": "합 계산하기",
          "expression": "a+b=2+\\frac53=\\frac{11}{3}",
          "explanation": "11/3에 해당하는 선택지는 ⑤입니다."
        }
      ],
      "correctReason": "a=2, b=5/3이므로 a+b=11/3이고 선택지 ⑤가 정답입니다.",
      "commonMistake": "경계점 한 곳만 확인하거나 a>0, b>0 조건을 적용하지 않으면 불필요한 해가 남습니다.",
      "verification": {
        "problemPage": 2,
        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
    },
    "2023_06_common_7": {
      "id": "2023_06_common_7",
      "status": "verified_internal_candidate",
      "exam": "2023학년도 6월 모의평가 수학 공통",
      "questionNumber": 7,
      "answer": 4,
      "answerMark": "④",
      "summary": "최댓값은 x=3π/4에서 1, 최솟값은 x=π/4에서 -1이므로 두 점을 잇는 직선의 기울기는 4/π입니다.",
      "approach": "-sin2x가 ±1이 되는 위치를 닫힌구간 안에서 찾고 두 점의 변화량을 계산합니다.",
      "concepts": [
        "사인함수의 최댓값과 최솟값",
        "두 점을 지나는 직선의 기울기"
      ],
      "steps": [
        {
          "title": "최댓값을 갖는 점 찾기",
          "expression": "-\\sin2a=1\\Rightarrow\\sin2a=-1\\Rightarrow a=\\frac{3\\pi}4",
          "explanation": "0≤a≤π에서 2a는 0부터 2π까지 움직입니다."
        },
        {
          "title": "최솟값을 갖는 점 찾기",
          "expression": "-\\sin2b=-1\\Rightarrow\\sin2b=1\\Rightarrow b=\\frac\\pi4",
          "explanation": "따라서 두 점은 (3π/4,1), (π/4,-1)입니다."
        },
        {
          "title": "기울기 계산하기",
          "expression": "\\frac{1-(-1)}{3\\pi/4-\\pi/4}=\\frac2{\\pi/2}=\\frac4\\pi",
          "explanation": "y의 변화량을 x의 변화량으로 나눕니다."
        }
      ],
      "correctReason": "직선의 기울기가 4/π이므로 선택지 ④가 정답입니다.",
      "commonMistake": "a와 b의 순서를 바꾸더라도 분자와 분모를 같은 순서로 빼야 합니다. 한쪽 순서만 바꾸면 부호가 틀립니다.",
      "verification": {
        "problemPage": 2,
        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
