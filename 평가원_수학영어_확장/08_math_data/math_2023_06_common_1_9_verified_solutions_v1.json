    "2023_06_common_8": {
      "id": "2023_06_common_8",
      "status": "verified_internal_candidate",
      "exam": "2023학년도 6월 모의평가 수학 공통",
      "questionNumber": 8,
      "answer": 3,
      "answerMark": "③",
      "summary": "평균값 정리에 의해 f(5)-f(1)≥20이므로 f(5)≥23이고, 기울기 5인 일차함수에서 등호가 성립합니다.",
      "approach": "도함수의 하한을 구간 전체의 함수값 증가량 하한으로 바꿉니다.",
      "concepts": [
        "평균값 정리",
        "도함수와 함수값의 증가량"
      ],
      "steps": [
        {
          "title": "평균값 정리 적용하기",
          "expression": "f(5)-f(1)=f'(c)(5-1)\\quad(1<c<5)",
          "explanation": "f는 실수 전체에서 미분가능하므로 [1,5]에서 평균값 정리를 사용할 수 있습니다."
        },
        {
          "title": "증가량의 하한 구하기",
          "expression": "f'(c)\\ge5\\Rightarrow f(5)-3\\ge5\\cdot4=20",
          "explanation": "따라서 f(5)는 적어도 23입니다."
        },
        {
          "title": "최솟값이 실제로 가능한지 확인하기",
          "expression": "f(x)=5x-2\\Rightarrow f(1)=3,\\quad f(5)=23",
          "explanation": "조건을 모두 만족하면서 23을 만드는 함수가 있으므로 하한 23은 실제 최솟값입니다."
        }
      ],
      "correctReason": "f(5)의 최솟값은 23이므로 선택지 ③이 정답입니다.",
      "commonMistake": "f'(x)≥5에서 f(5)>23이라고 단정하지 마세요. f'(x)=5인 함수도 허용되므로 등호가 성립할 수 있습니다.",
      "verification": {
        "problemPage": 3,
        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
