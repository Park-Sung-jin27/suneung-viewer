    "2024_09_cal_24": {
      "id": "2024_09_cal_24",
      "status": "verified_internal_candidate",
      "exam": "2024학년도 9월 모의평가 수학 미적분",
      "questionNumber": 24,
      "answer": "2",
      "answerMark": "②",
      "summary": "dx/dt와 dy/dt를 구해 나누면 t=π/4에서 기울기는 -1입니다.",
      "approach": "매개변수 곡선의 기울기 dy/dx=(dy/dt)/(dx/dt)를 사용합니다.",
      "concepts": ["매개변수 미분", "삼각함수의 미분"],
      "steps": [
        {
          "title": "각 좌표 미분",
          "expression": "\\frac{dx}{dt}=1-2\\sin2t,\\quad\\frac{dy}{dt}=2\\sin t\\cos t",
          "explanation": "cos2t와 sin²t를 t에 대해 미분합니다."
        },
        {
          "title": "기울기 식",
          "expression": "\\frac{dy}{dx}=\\frac{2\\sin t\\cos t}{1-2\\sin2t}",
          "explanation": "dy/dt를 dx/dt로 나눕니다."
        },
        {
          "title": "t=π/4 대입",
          "expression": "\\left.\\frac{dy}{dx}\\right|_{t=\\pi/4}=\\frac1{1-2}=-1",
          "explanation": "기울기는 -1이므로 정답은 ②입니다."
        }
      ],
      "correctReason": "t=π/4에서 dx/dt=-1로 0이 아니므로 비율 공식이 유효합니다.",
      "commonMistake": "cos2t를 미분할 때 안쪽 함수 2t의 미분계수 2를 빠뜨리지 마세요.",
      "verification": {
        "problemPage": 13,
        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
    },
    "2024_09_cal_25": {
      "id": "2024_09_cal_25",
      "status": "verified_internal_candidate",
      "exam": "2024학년도 9월 모의평가 수학 미적분",
      "questionNumber": 25,
      "answer": "2",
      "answerMark": "②",
      "summary": "적분함수가 f'(x)f(x)이므로 f(x)²/2의 양 끝값을 계산해 e²/2+e를 얻습니다.",
      "approach": "1+1/x가 f'(x)임을 먼저 알아봅니다.",
      "concepts": ["치환적분", "합성함수의 미분"],
      "steps": [
        {
          "title": "미분형 확인",
          "expression": "f(x)=x+\\ln x\\Rightarrow f'(x)=1+\\frac1x",
          "explanation": "적분함수는 f'(x)f(x) 꼴입니다."
        },
        {
          "title": "원시함수",
          "expression": "\\int f'(x)f(x)dx=\\frac12f(x)^2",
          "explanation": "u=f(x)로 치환하면 udu의 적분입니다."
        },
        {
          "title": "경계값 계산",
          "expression": "\\frac12[(e+1)^2-1^2]=\\frac{e^2}{2}+e",
          "explanation": "f(e)=e+1, f(1)=1이므로 정답은 ②입니다."
        }
      ],
      "correctReason": "주어진 계수가 정확히 f의 도함수라서 한 번의 치환으로 적분됩니다.",
      "commonMistake": "ln e=1과 ln1=0을 바꾸어 대입하지 마세요.",
      "verification": {
        "problemPage": 14,
        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
    },
    "2024_09_cal_26": {
      "id": "2024_09_cal_26",
      "status": "verified_internal_candidate",
      "exam": "2024학년도 9월 모의평가 수학 미적분",
      "questionNumber": 26,
      "answer": "5",
      "answerMark": "⑤",
      "summary": "등차수열 부분은 망원급수로 1/d, 등비급수는 (1+d)/d가 되어 d=2와 합 3/2를 얻습니다.",
      "approach": "등차수열의 공차 d로 두 급수의 합을 각각 표현합니다.",
      "concepts": ["망원급수", "등비급수"],
      "steps": [
        {
          "title": "등차수열 급수",
          "expression": "\\sum_{n=1}^{\\infty}\\frac1{a_na_{n+1}}=\\frac1d",
          "explanation": "1/(a_na_{n+1})=(1/d)(1/a_n-1/a_{n+1})로 분해하면 중간항이 소거됩니다."
        },
        {
          "title": "등비급수 표현",
          "expression": "a_2b_2=1\\Rightarrow r=\\frac1{1+d},\\quad\\sum b_n=\\frac{1+d}{d}",
          "explanation": "a2=1+d이고 b1=1이므로 공비와 무한합이 결정됩니다."
        },
        {
          "title": "d와 합 결정",
          "expression": "\\frac1d+\\frac{1+d}{d}=2\\Rightarrow d=2,\\quad\\sum b_n=\\frac32",
          "explanation": "요구한 급수의 합은 3/2이므로 정답은 ⑤입니다."
        }
      ],
      "correctReason": "두 급수 모두 같은 공차 d로 표현되어 주어진 전체 합이 d를 유일하게 정합니다.",
      "commonMistake": "망원급수의 합을 1이 아니라 1/d로 계산해야 합니다.",
      "verification": {
        "problemPage": 14,
        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
