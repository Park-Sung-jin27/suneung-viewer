    "2024_09_cal_23": {
      "id": "2024_09_cal_23",
      "status": "verified_internal_candidate",
      "exam": "2024학년도 9월 모의평가 수학 미적분",
      "questionNumber": 23,
      "answer": "4",
      "answerMark": "④",
      "summary": "지수함수의 기본 극한을 적용하면 계수의 비 7/2입니다.",
      "approach": "분자와 분모를 각각 x로 나누어 (e^u-1)/u 꼴을 만듭니다.",
      "concepts": ["지수함수의 극한", "극한의 곱셈"],
      "steps": [
        {
          "title": "기본 극한 분리",
          "expression": "\\frac{e^{7x}-1}{e^{2x}-1}=\\frac{e^{7x}-1}{7x}\\cdot\\frac{2x}{e^{2x}-1}\\cdot\\frac72",
          "explanation": "각 지수의 계수가 기본 극한 밖에 남도록 정리합니다."
        },
        {
          "title": "두 기본 극한",
          "expression": "\\lim_{x\\to0}\\frac{e^{7x}-1}{7x}=1,\\quad\\lim_{x\\to0}\\frac{2x}{e^{2x}-1}=1",
          "explanation": "lim(e^u-1)/u=1을 각각 적용합니다."
        },
        {
          "title": "최종값",
          "expression": "1\\cdot1\\cdot\\frac72=\\frac72",
          "explanation": "정답은 ④입니다."
        }
      ],
      "correctReason": "x가 0으로 갈 때 두 지수식의 일차 변화율이 각각 7과 2입니다.",
      "commonMistake": "e의 지수 7x와 2x에서 계수 7, 2를 빠뜨리지 마세요.",
      "verification": {
        "problemPage": 13,
        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
