    "2022_09_geo_30": {
      "id": "2022_09_geo_30",
      "status": "verified_internal_candidate",
      "exam": "2022학년도 9월 모의평가 수학 기하",
      "questionNumber": 30,
      "answer": "45",
      "answerMark": null,
      "summary": "AP와 BQ를 단위벡터로 정리하면 P₀와 Q₀의 방향이 결정되고, 선분 AP₀의 조건 범위 끝점에서 |Q₀X|²의 최댓값 41/4를 얻어 p+q=45입니다.",
      "approach": "먼저 AP·AQ를 최소화하는 두 방향을 내적의 최솟값으로 정한 뒤, X를 선분의 매개변수로 나타내어 남은 부등식과 거리의 단조성을 처리합니다.",
      "concepts": [
        "단위벡터와 내적의 최솟값",
        "벡터의 매개변수 표현",
        "선분 위 거리의 최댓값"
      ],
      "steps": [
        {
          "title": "두 이동벡터 정하기",
          "expression": "\\vec u=\\overrightarrow{AP},\\quad|\\vec u|=1,\\quad\\vec v=\\overrightarrow{BQ},\\quad|\\vec v|=2",
          "explanation": "조건 AP·OC≥√2/2는 OC=(1,0)이므로 u의 x성분이 √2/2 이상이라는 뜻입니다."
        },
        {
          "title": "Q의 최적 방향 구하기",
          "expression": "\\vec u\\cdot\\overrightarrow{AQ}=\\vec u\\cdot((3,1)+\\vec v)\\ge\\vec u\\cdot(3,1)-2",
          "explanation": "고정된 u에 대해 u·v는 v=-2u일 때 최소 -2가 됩니다. 따라서 최적 조건에서는 v=-2u입니다."
        },
        {
          "title": "P의 최적 방향 구하기",
          "expression": "\\vec u=(\\cos\\theta,\\sin\\theta),\\quad-\\frac\\pi4\\le\\theta\\le\\frac\\pi4",
          "explanation": "3cosθ+sinθ를 이 구간에서 비교하면 최솟값은 θ=-π/4에서 생깁니다."
        },
        {
          "title": "P₀와 Q₀의 벡터 확정하기",
          "expression": "\\vec u=\\left(\\frac1{\\sqrt2},-\\frac1{\\sqrt2}\\right),\\qquad\\overrightarrow{BQ_0}=-2\\vec u=(-\\sqrt2,\\sqrt2)",
          "explanation": "이 두 벡터가 AP·AQ를 최소로 만드는 방향입니다."
        },
        {
          "title": "X의 허용 범위 구하기",
          "expression": "X=A+t\\vec u\\ (0\\le t\\le1),\\quad\\overrightarrow{BX}\\cdot\\overrightarrow{BQ_0}=2\\sqrt2-2t\\ge1",
          "explanation": "따라서 0≤t≤√2-1/2입니다."
        },
        {
          "title": "거리의 최댓값 구하기",
          "expression": "|\\overrightarrow{Q_0X}|^2=10+(t+2)^2-2\\sqrt2(t+2)",
          "explanation": "허용 구간에서는 t가 커질수록 이 값이 커지므로 t=√2-1/2를 대입합니다."
        },
        {
          "title": "p+q 계산하기",
          "expression": "|\\overrightarrow{Q_0X}|_{\\max}^2=\\frac{41}{4}=\\frac qp\\Rightarrow p+q=4+41=45",
          "explanation": "41과 4는 서로소이므로 최종 답은 45입니다."
        }
      ],
      "correctReason": "거리 제곱의 최댓값이 41/4이므로 p=4, q=41이고 p+q=45입니다.",
      "commonMistake": "AP·AQ를 최소화할 때 P와 Q를 따로 임의 선택하지 마세요. 고정된 AP 방향에서 BQ=-2AP가 먼저 결정되고, 그다음 허용된 AP 방향을 비교해야 합니다.",
