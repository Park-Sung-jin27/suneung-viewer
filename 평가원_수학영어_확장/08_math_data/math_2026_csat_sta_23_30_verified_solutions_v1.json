      "exam": "2026학년도 대학수학능력시험 수학 확률과 통계",
      "questionNumber": 23,
      "answer": "3",
      "answerMark": "③",
      "summary": "네 문자에서 중복을 허용해 세 자리를 채우므로 전체 경우의 수는 64입니다.",
      "approach": "각 자리에 올 수 있는 문자 수를 확인하고 곱의 법칙을 바로 적용합니다.",
      "concepts": ["중복순열", "곱의 법칙"],
      "steps": [
        {
          "title": "자리별 선택",
          "expression": "4\\times4\\times4",
          "explanation": "세 자리마다 네 문자 중 하나를 독립적으로 선택할 수 있습니다."
        },
        {
          "title": "경우의 수",
          "expression": "{}_4\\Pi_3=4^3=64",
          "explanation": "중복을 허용하는 세 자리 배열은 모두 64가지입니다."
        }
      ],
      "correctReason": "계산값 64가 세 번째 선지와 일치하므로 정답은 ③입니다.",
      "commonMistake": "중복을 허용한다는 조건을 놓치고 서로 다른 세 문자만 뽑아 순열로 계산하면 안 됩니다.",
      "verification": {"problemPage": 9, "answerTablePage": 1, "problemMatchedPdf": true, "choicesMatchedPdf": true, "answerMatchedPdf": true, "independentDerivation": true}
    },
    "2026_csat_sta_24": {
      "id": "2026_csat_sta_24",
      "status": "verified_internal_candidate",
      "exam": "2026학년도 대학수학능력시험 수학 확률과 통계",
      "questionNumber": 24,
      "answer": "1",
      "answerMark": "①",
      "summary": "조건부확률로 교집합을 구한 뒤 합사건의 확률식을 풀면 P(B)는 7/10입니다.",
      "approach": "먼저 P(A∩B)를 계산하고 확률의 덧셈정리에 대입합니다.",
      "concepts": ["조건부확률", "확률의 덧셈정리"],
      "steps": [
        {
          "title": "교집합 계산",
          "expression": "P(A\\cap B)=P(A)P(B\\mid A)=\\frac25\\cdot\\frac14=\\frac1{10}",
          "explanation": "조건부확률 식을 변형하여 두 사건의 교집합 확률을 구합니다."
        },
        {
          "title": "합사건 적용",
          "expression": "1=\\frac25+P(B)-\\frac1{10}\\Rightarrow P(B)=\\frac7{10}",
          "explanation": "합사건의 확률이 1이라는 조건으로 P(B)를 정리합니다."
        }
      ],
      "correctReason": "P(B)=7/10이므로 이에 해당하는 정답은 ①입니다.",
      "commonMistake": "P(B|A)를 P(A∩B)와 같은 값으로 두지 말고 반드시 P(A)를 곱해야 합니다.",
      "verification": {"problemPage": 9, "answerTablePage": 1, "problemMatchedPdf": true, "choicesMatchedPdf": true, "answerMatchedPdf": true, "independentDerivation": true}
    },
    "2026_csat_sta_25": {
