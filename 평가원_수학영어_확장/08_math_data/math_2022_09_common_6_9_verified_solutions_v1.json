    "2022_09_common_6": {
      "id": "2022_09_common_6",
      "status": "verified_internal_candidate",
      "exam": "2022학년도 9월 모의평가 수학",
      "questionNumber": 6,
      "answer": 1,
      "answerMark": "①",
      "summary": "두 분수를 통분하면 2tan²θ=4이고, θ가 제2사분면에 있으므로 cosθ=-√3/3입니다.",
      "approach": "식을 sin²θ와 cos²θ의 비로 정리한 뒤, 사분면 조건으로 코사인의 부호를 결정합니다.",
      "concepts": [
        "삼각함수의 기본 관계",
        "탄젠트와 코사인의 관계",
        "사분면별 부호"
      ],
      "steps": [
        {
          "title": "분수식 통분하기",
          "expression": "\\frac{\\sin\\theta}{1-\\sin\\theta}-\\frac{\\sin\\theta}{1+\\sin\\theta}=\\frac{2\\sin^2\\theta}{1-\\sin^2\\theta}",
          "explanation": "두 분수의 공통분모를 만들고 분자를 정리합니다."
        },
        {
          "title": "탄젠트로 바꾸기",
          "expression": "\\frac{2\\sin^2\\theta}{\\cos^2\\theta}=2\\tan^2\\theta=4\\Rightarrow\\tan^2\\theta=2",
          "explanation": "1-sin²θ=cos²θ를 사용하면 탄젠트의 제곱이 나타납니다."
        },
        {
          "title": "코사인의 크기 구하기",
          "expression": "\\cos^2\\theta=\\frac{1}{1+\\tan^2\\theta}=\\frac13",
          "explanation": "1+tan²θ=1/cos²θ 관계를 적용합니다."
        },
        {
          "title": "부호 결정하기",
          "expression": "\\frac{\\pi}{2}<\\theta<\\pi\\Rightarrow\\cos\\theta=-\\frac{\\sqrt3}{3}",
          "explanation": "제2사분면에서는 코사인이 음수이므로 음의 값을 선택합니다."
        }
      ],
      "correctReason": "cosθ=-√3/3이므로 선지 ①이 정답입니다.",
      "commonMistake": "cos²θ=1/3에서 곧바로 양의 제곱근만 택하지 마세요. 제2사분면 조건이 음의 부호를 결정합니다.",
      "verification": {
