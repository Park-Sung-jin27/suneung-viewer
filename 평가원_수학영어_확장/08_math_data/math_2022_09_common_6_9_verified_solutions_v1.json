        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
    },
    "2022_09_common_7": {
      "id": "2022_09_common_7",
      "status": "verified_internal_candidate",
      "exam": "2022학년도 9월 모의평가 수학",
      "questionNumber": 7,
      "answer": 4,
      "answerMark": "④",
      "summary": "각 항을 두 역수의 차로 바꾸면 합이 소거되고, n=12를 대입해 a₁₃=-3을 얻습니다.",
      "approach": "분모의 곱을 보고 일반항을 1/aₖ-1/aₖ₊₁로 분해한 뒤 망원합을 사용합니다.",
      "concepts": [
        "부분분수 분해",
        "망원합",
        "수열의 일반항"
      ],
      "steps": [
        {
          "title": "일반항 분해하기",
          "expression": "\\frac{a_{k+1}-a_k}{a_ka_{k+1}}=\\frac1{a_k}-\\frac1{a_{k+1}}",
          "explanation": "두 역수의 차를 통분하면 주어진 합의 일반항과 같습니다."
        },
        {
          "title": "합 소거하기",
          "expression": "\\sum_{k=1}^{n}\\left(\\frac1{a_k}-\\frac1{a_{k+1}}\\right)=\\frac1{a_1}-\\frac1{a_{n+1}}=\\frac1n",
          "explanation": "가운데 항들이 앞뒤에서 한 번씩 나타나 모두 지워집니다."
        },
        {
          "title": "n=12 대입하기",
          "expression": "-\\frac14-\\frac1{a_{13}}=\\frac1{12}",
          "explanation": "a₁=-4이고 구하려는 항이 a₁₃이므로 n=12를 사용합니다."
        },
        {
          "title": "a₁₃ 구하기",
          "expression": "-\\frac1{a_{13}}=\\frac13\\Rightarrow a_{13}=-3",
          "explanation": "양변을 정리한 뒤 역수를 취합니다."
        }
      ],
      "correctReason": "a₁₃=-3이므로 선지 ④가 정답입니다.",
      "commonMistake": "a₁₃을 구할 때 n=13을 넣으면 합의 끝항이 a₁₄가 됩니다. 합의 끝이 aₙ₊₁이므로 n=12입니다.",
      "verification": {
