        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
    },
    "2022_09_common_8": {
      "id": "2022_09_common_8",
      "status": "verified_internal_candidate",
      "exam": "2022학년도 9월 모의평가 수학",
      "questionNumber": 8,
      "answer": 2,
      "answerMark": "②",
      "summary": "두 극한은 f(0)=f(1)=0과 f'(0)=f'(1)=1을 뜻하며, 이를 만족하는 삼차함수에서 f(2)=6입니다.",
      "approach": "분모가 0이 되는 두 점을 함수의 근으로 잡고, 도함숫값 조건으로 남은 일차식의 계수를 정합니다.",
      "concepts": [
        "미분계수의 정의",
        "인수정리",
        "삼차함수의 결정"
      ],
      "steps": [
        {
          "title": "극한 조건 해석하기",
          "expression": "f(0)=f(1)=0,\\qquad f'(0)=f'(1)=1",
          "explanation": "각 극한이 유한하려면 분자도 0이어야 하고, 그때 두 극한은 각각 미분계수가 됩니다."
        },
        {
          "title": "삼차함수 세우기",
          "expression": "f(x)=x(x-1)(Ax+B)",
          "explanation": "0과 1이 모두 근이고 f가 삼차함수이므로 남는 인수는 일차식입니다."
        },
        {
          "title": "두 계수 정하기",
          "expression": "f'(0)=-B=1,\\qquad f'(1)=A+B=1\\Rightarrow A=2,\\ B=-1",
          "explanation": "각 단순근에서 다른 인수들의 곱을 이용하면 도함숫값을 빠르게 구할 수 있습니다."
        },
        {
          "title": "f(2) 계산하기",
          "expression": "f(2)=2(2-1)(2\\cdot2-1)=6",
          "explanation": "구한 함수 f(x)=x(x-1)(2x-1)에 x=2를 대입합니다."
        }
      ],
      "correctReason": "f(2)=6이므로 선지 ②가 정답입니다.",
      "commonMistake": "극한값이 1이라는 사실만 보고 f(0)과 f(1)이 1이라고 두면 안 됩니다. 분모가 0이므로 먼저 f(0)=f(1)=0이어야 합니다.",
      "verification": {
        "problemPage": 3,
        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
    },
    "2022_09_common_9": {
      "id": "2022_09_common_9",
      "status": "verified_internal_candidate",
      "exam": "2022학년도 9월 모의평가 수학",
      "questionNumber": 9,
      "answer": 3,
      "answerMark": "③",
      "summary": "가속도 조건에서 k=1을 구하고, 3≤t≤4에서 속도가 음수이므로 이동거리는 -∫₃⁴v(t)dt=27입니다.",
      "approach": "속도를 미분해 k를 결정한 뒤, 해당 구간의 속도 부호를 확인하고 절댓값을 적용해 거리를 계산합니다.",
      "concepts": [
        "속도와 가속도",
        "정적분과 이동거리",
        "속도의 부호"
      ],
      "steps": [
        {
          "title": "가속도 구하기",
          "expression": "a(t)=v'(t)=-12t^2+24t=-12(t-1)^2+12",
          "explanation": "속도함수를 시간에 대해 미분하고 완전제곱식으로 정리합니다."
        },
        {
          "title": "k 결정하기",
          "expression": "a(k)=12\\Rightarrow-12(k-1)^2=0\\Rightarrow k=1",
          "explanation": "가속도가 12인 시각은 t=1 하나뿐입니다."
        },
        {
          "title": "속도의 부호 확인하기",
          "expression": "v(t)=4t^2(3-t)\\leq0\\quad(3\\leq t\\leq4)",
          "explanation": "t=3에서 0이고 그 뒤에는 3-t가 음수이므로 점은 음의 방향으로 움직입니다."
        },
        {
          "title": "이동거리 계산하기",
          "expression": "-\\int_3^4v(t)\\,dt=-\\left[-t^4+4t^3\\right]_3^4=27",
          "explanation": "속도가 음수인 구간이므로 변위의 부호를 바꿔 이동거리를 구합니다."
        }
      ],
      "correctReason": "시각 3부터 4까지의 이동거리가 27이므로 선지 ③이 정답입니다.",
      "commonMistake": "속도를 그대로 적분한 -27은 변위입니다. 이동거리는 속도의 절댓값을 적분하므로 27입니다.",
      "verification": {
