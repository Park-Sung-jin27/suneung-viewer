    "2022_06_common_8": {
      "id": "2022_06_common_8",
      "status": "verified_internal_candidate",
      "exam": "2022학년도 6월 모의평가 수학",
      "questionNumber": 8,
      "answer": 4,
      "answerMark": "④",
      "summary": "x=a에서 제곱한 두 식의 값이 같아야 하므로 a=2 또는 6이고, 그 합은 8입니다.",
      "approach": "각 조각은 이미 연속이므로 경계 x=a에서 f(x)²의 좌극한과 함숫값만 비교합니다.",
      "concepts": [
        "구간별로 정의된 함수",
        "함수의 연속",
        "제곱식 방정식"
      ],
      "steps": [
        {
          "title": "경계의 두 값 쓰기",
          "expression": "\\lim_{x\\to a-}\\{f(x)\\}^2=(-2a+6)^2,\\quad \\{f(a)\\}^2=a^2",
          "explanation": "x<a에서는 -2x+6을, x≥a에서는 2x-a를 사용하며 f(a)=a입니다."
        },
        {
          "title": "연속 조건 풀기",
          "expression": "(-2a+6)^2=a^2 \\Rightarrow -2a+6=a\\;\\text{또는}\\;-2a+6=-a",
          "explanation": "제곱이 같은 두 수는 서로 같거나 서로 반대입니다."
        },
        {
          "title": "모든 값 더하기",
          "expression": "a=2\\;\\text{또는}\\;a=6 \\Rightarrow 2+6=8",
          "explanation": "두 경우 모두 f(x)²가 x=a에서 이어집니다."
        }
      ],
      "correctReason": "모든 상수 a의 합이 8이므로 선지 ④가 정답입니다.",
      "commonMistake": "f 자체가 연속이어야 한다고 두 식을 바로 같게 놓으면 a=2만 얻습니다. 문제의 함수는 f(x)²입니다.",
      "verification": {
