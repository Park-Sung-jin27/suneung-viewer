    "2022_06_common_10": {
      "id": "2022_06_common_10",
      "status": "verified_internal_candidate",
      "exam": "2022학년도 6월 모의평가 수학",
      "questionNumber": 10,
      "answer": 2,
      "answerMark": "②",
      "summary": "교점 조건을 x(x+3)=n으로 바꾸면 1<x<2에서 4<n<10이므로 가능한 자연수의 합은 35입니다.",
      "approach": "로그식을 하나로 합친 뒤 x가 1과 2 사이일 때 증가하는 식 x(x+3)의 값 범위를 구합니다.",
      "concepts": [
        "로그의 성질",
        "로그방정식",
        "증가함수의 값 범위"
      ],
      "steps": [
        {
          "title": "교점 방정식 정리하기",
          "expression": "\\log_n x=-\\log_n(x+3)+1 \\Rightarrow \\log_n\\{x(x+3)\\}=1",
          "explanation": "두 로그를 왼쪽에 모아 곱의 로그로 합칩니다."
        },
        {
          "title": "n과 x의 관계 구하기",
          "expression": "\\log_n\\{x(x+3)\\}=1 \\Rightarrow x(x+3)=n",
          "explanation": "밑 n의 로그값이 1이므로 진수는 n입니다."
        },
        {
          "title": "가능한 자연수 찾기",
          "expression": "1<x<2 \\Rightarrow 4<x(x+3)<10 \\Rightarrow n=5,6,7,8,9",
          "explanation": "x>0에서 x(x+3)은 증가하므로 양 끝값 4와 10 사이의 자연수만 가능합니다."
        },
        {
          "title": "합 계산하기",
          "expression": "5+6+7+8+9=35",
          "explanation": "조건을 만족하는 모든 자연수 n을 더합니다."
        }
      ],
      "correctReason": "가능한 n의 합이 35이므로 선지 ②가 정답입니다.",
      "commonMistake": "끝점 x=1과 x=2는 포함되지 않으므로 n=4와 n=10을 포함하면 안 됩니다.",
      "verification": {
