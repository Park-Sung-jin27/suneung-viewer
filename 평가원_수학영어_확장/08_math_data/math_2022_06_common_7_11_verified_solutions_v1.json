        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
    },
    "2022_06_common_9": {
      "id": "2022_06_common_9",
      "status": "verified_internal_candidate",
      "exam": "2022학년도 6월 모의평가 수학",
      "questionNumber": 9,
      "answer": 5,
      "answerMark": "⑤",
      "summary": "점화식을 네 번 적용하면 항이 되돌아오는 구조를 이용해 a₄=a₁₂=1/2, a₁=4를 얻으므로 합은 9/2입니다.",
      "approach": "홀수 번째와 짝수 번째 규칙을 묶어 네 항마다 같은 값이 반복되는지 먼저 확인합니다.",
      "concepts": [
        "수열의 귀납적 정의",
        "점화식의 주기",
        "항의 역추적"
      ],
      "steps": [
        {
          "title": "네 항의 변화 확인하기",
          "expression": "a_2=\\frac{1}{a_1},\\quad a_3=\\frac{8}{a_1},\\quad a_4=\\frac{a_1}{8},\\quad a_5=a_1",
          "explanation": "홀수 n에서는 역수를, 짝수 n에서는 8배를 차례로 적용하면 네 단계 뒤 같은 값으로 돌아옵니다."
        },
        {
          "title": "주어진 항 연결하기",
          "expression": "a_{12}=a_4=\\frac12",
          "explanation": "네 항마다 같은 값이 반복되므로 12번째 항과 4번째 항이 같습니다."
        },
        {
          "title": "첫째항과 합 구하기",
          "expression": "a_4=\\frac{a_1}{8}=\\frac12 \\Rightarrow a_1=4,\\quad a_1+a_4=4+\\frac12=\\frac92",
          "explanation": "a₄와 a₁의 관계에 주어진 값을 대입합니다."
        }
      ],
      "correctReason": "a₁+a₄=9/2이므로 선지 ⑤가 정답입니다.",
      "commonMistake": "n의 홀짝은 새로 구하는 항의 번호가 아니라 점화식에 적힌 n을 기준으로 판단해야 합니다.",
      "verification": {
