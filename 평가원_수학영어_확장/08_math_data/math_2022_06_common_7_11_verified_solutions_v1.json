    "2022_06_common_7": {
      "id": "2022_06_common_7",
      "status": "verified_internal_candidate",
      "exam": "2022학년도 6월 모의평가 수학",
      "questionNumber": 7,
      "answer": 2,
      "answerMark": "②",
      "summary": "부분합의 차 S₃-S₂를 a₃로 바꾸고 등차수열의 공차를 구하면 S₁₀은 110입니다.",
      "approach": "부분합과 일반항의 관계로 조건을 단순화한 뒤 등차수열의 일반항과 합 공식을 차례로 사용합니다.",
      "concepts": [
        "등차수열의 일반항",
        "부분합과 일반항",
        "등차수열의 합"
      ],
      "steps": [
        {
          "title": "부분합의 차 바꾸기",
          "expression": "S_3-S_2=a_3",
          "explanation": "첫째항부터 셋째항까지의 합에서 둘째항까지의 합을 빼면 셋째항만 남습니다."
        },
        {
          "title": "공차 구하기",
          "expression": "a_6=2a_3 \\Rightarrow 2+5d=2(2+2d) \\Rightarrow d=2",
          "explanation": "첫째항이 2인 등차수열의 일반항 aₙ=2+(n-1)d를 조건에 대입합니다."
        },
        {
          "title": "열째 부분합 계산하기",
          "expression": "S_{10}=\\frac{10}{2}\\{2\\cdot2+9\\cdot2\\}=5\\cdot22=110",
          "explanation": "첫째항 2와 공차 2를 등차수열의 합 공식에 넣습니다."
        }
      ],
      "correctReason": "S₁₀=110이므로 선지 ②가 정답입니다.",
      "commonMistake": "S₃-S₂를 a₂로 착각하면 안 됩니다. Sₙ-Sₙ₋₁=aₙ이므로 여기서는 a₃입니다.",
      "verification": {
