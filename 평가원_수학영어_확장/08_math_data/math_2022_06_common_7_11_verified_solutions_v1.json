    "2022_06_common_11": {
      "id": "2022_06_common_11",
      "status": "verified_internal_candidate",
      "exam": "2022학년도 6월 모의평가 수학",
      "questionNumber": 11,
      "answer": 2,
      "answerMark": "②",
      "summary": "한 주기 [-1,1]의 적분은 1이고 남는 길이 1의 적분은 5/6이므로 전체는 17/6입니다.",
      "approach": "먼저 주기 하나의 적분을 구한 다음 길이 5인 구간을 두 주기와 남는 한 구간으로 나눕니다.",
      "concepts": [
        "주기함수의 정적분",
        "치환적분",
        "정적분의 구간 분할"
      ],
      "steps": [
        {
          "title": "왼쪽 반주기 적분하기",
          "expression": "\\int_{-1}^{0}g(x)\\,dx=\\int_{-1}^{0}\\{-f(x+1)+1\\}\\,dx=1-\\frac16=\\frac56",
          "explanation": "t=x+1로 바꾸면 f의 적분 구간이 0부터 1이 됩니다."
        },
        {
          "title": "한 주기의 적분 구하기",
          "expression": "\\int_{-1}^{1}g(x)\\,dx=\\frac56+\\int_0^1 f(x)\\,dx=\\frac56+\\frac16=1",
          "explanation": "[-1,0]과 [0,1]의 적분을 더합니다."
        },
        {
          "title": "전체 구간 나누기",
          "expression": "\\int_{-3}^{2}g(x)\\,dx=2\\int_{-1}^{1}g(x)\\,dx+\\int_{1}^{2}g(x)\\,dx",
          "explanation": "[-3,1]은 길이 2인 주기 두 개이고 [1,2]가 남습니다."
        },
        {
          "title": "남는 구간과 최종값 계산하기",
          "expression": "\\int_1^2 g(x)\\,dx=\\int_{-1}^0 g(x)\\,dx=\\frac56,\\quad 2+\\frac56=\\frac{17}{6}",
          "explanation": "주기가 2이므로 [1,2]의 적분은 [-1,0]의 적분과 같습니다."
        }
      ],
      "correctReason": "전체 정적분이 17/6이므로 선지 ②가 정답입니다.",
      "commonMistake": "구간 길이 5를 두 주기로만 처리하면 길이 1의 나머지 구간을 빠뜨립니다.",
