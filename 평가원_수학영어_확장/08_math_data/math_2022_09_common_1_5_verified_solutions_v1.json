    "2022_09_common_1": {
      "id": "2022_09_common_1",
      "status": "verified_internal_candidate",
      "exam": "2022학년도 9월 모의평가 수학",
      "questionNumber": 1,
      "answer": 1,
      "answerMark": "①",
      "summary": "네제곱근을 지수로 바꾼 뒤 같은 밑 3의 지수를 더하면 값은 1/9입니다.",
      "approach": "근호를 분수 지수로 바꾸고, 같은 밑을 곱할 때 지수를 더하는 법칙을 적용합니다.",
      "concepts": [
        "근호와 분수 지수",
        "지수법칙"
      ],
      "steps": [
        {
          "title": "근호를 지수로 바꾸기",
          "expression": "\\frac{1}{\\sqrt[4]{3}}=3^{-\\frac14}",
          "explanation": "3의 네제곱근은 3의 1/4제곱이므로, 그 역수의 지수는 -1/4입니다."
        },
        {
          "title": "지수 더하기",
          "expression": "3^{-\\frac14}\\times3^{-\\frac74}=3^{-2}",
          "explanation": "밑이 같은 거듭제곱의 곱에서는 두 지수 -1/4과 -7/4를 더합니다."
        },
        {
          "title": "양의 지수로 나타내기",
          "expression": "3^{-2}=\\frac{1}{3^2}=\\frac19",
          "explanation": "음의 지수는 같은 거듭제곱의 역수입니다."
        }
      ],
      "correctReason": "계산값이 1/9이므로 선지 ①이 정답입니다.",
      "commonMistake": "네제곱근의 역수를 3의 -4제곱으로 바꾸지 마세요. 근호의 차수 4는 지수의 분모가 됩니다.",
      "verification": {
