    "2022_09_common_5": {
      "id": "2022_09_common_5",
      "status": "verified_internal_candidate",
      "exam": "2022학년도 9월 모의평가 수학",
      "questionNumber": 5,
      "answer": 3,
      "answerMark": "③",
      "summary": "도함수의 부호가 바뀌는 x=-2와 x=1에서 극댓값 21, 극솟값 -6을 얻으므로 합은 15입니다.",
      "approach": "도함수를 인수분해해 임계점을 찾고, 부호 변화로 극대·극소를 구분한 뒤 함숫값을 계산합니다.",
      "concepts": [
        "도함수의 인수분해",
        "함수의 증가와 감소",
        "극댓값과 극솟값"
      ],
      "steps": [
        {
          "title": "도함수와 임계점 구하기",
          "expression": "f'(x)=6x^2+6x-12=6(x+2)(x-1)",
          "explanation": "f'(x)=0이 되는 점은 x=-2와 x=1입니다."
        },
        {
          "title": "극대와 극소 구분하기",
          "expression": "f':+\\to-\\text{ at }x=-2,\\qquad f':-\\to+\\text{ at }x=1",
          "explanation": "x=-2에서는 증가에서 감소로 바뀌므로 극대, x=1에서는 감소에서 증가로 바뀌므로 극소입니다."
        },
        {
          "title": "두 함숫값 계산하기",
          "expression": "M=f(-2)=21,\\qquad m=f(1)=-6",
          "explanation": "두 임계점을 원래 함수에 대입해 극댓값과 극솟값을 구합니다."
        },
        {
          "title": "극값의 합 구하기",
          "expression": "M+m=21+(-6)=15",
          "explanation": "극댓값과 극솟값을 더합니다."
        }
      ],
      "correctReason": "M+m=15이므로 선지 ③이 정답입니다.",
      "commonMistake": "극대가 되는 x=-2와 극댓값 21을 혼동하지 마세요. 문제는 x좌표가 아니라 함숫값의 합을 묻습니다.",
