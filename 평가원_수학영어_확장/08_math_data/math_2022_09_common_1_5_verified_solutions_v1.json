      }
    },
    "2022_09_common_2": {
      "id": "2022_09_common_2",
      "status": "verified_internal_candidate",
      "exam": "2022학년도 9월 모의평가 수학",
      "questionNumber": 2,
      "answer": 5,
      "answerMark": "⑤",
      "summary": "다항함수를 미분한 뒤 x=1을 대입하면 f'(1)=10입니다.",
      "approach": "각 항을 미분해 도함수를 먼저 구하고, 마지막에 x=1을 대입합니다.",
      "concepts": [
        "다항함수의 미분",
        "도함숫값"
      ],
      "steps": [
        {
          "title": "함수 미분하기",
          "expression": "f'(x)=6x^2+4",
          "explanation": "2x³을 미분하면 6x², 4x를 미분하면 4, 상수 5를 미분하면 0입니다."
        },
        {
          "title": "x=1 대입하기",
          "expression": "f'(1)=6\\cdot1^2+4=10",
          "explanation": "구한 도함수에 1을 넣어 해당 점의 미분계수를 계산합니다."
        }
      ],
      "correctReason": "f'(1)=10이므로 선지 ⑤가 정답입니다.",
      "commonMistake": "f(1)을 구하는 문제가 아닙니다. 먼저 f를 미분한 뒤 1을 대입해야 합니다.",
      "verification": {
