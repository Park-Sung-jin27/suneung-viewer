    "2022_09_common_3": {
      "id": "2022_09_common_3",
      "status": "verified_internal_candidate",
      "exam": "2022학년도 9월 모의평가 수학",
      "questionNumber": 3,
      "answer": 5,
      "answerMark": "⑤",
      "summary": "공비를 r이라 두면 주어진 곱에서 r⁴=9가 나오고, 구하려는 비도 r⁴이므로 값은 9입니다.",
      "approach": "각 항을 첫째항과 공비로 나타낸 뒤, 조건과 목표식에 공통으로 등장하는 r⁴을 찾습니다.",
      "concepts": [
        "등비수열의 일반항",
        "등비수열의 항의 비"
      ],
      "steps": [
        {
          "title": "주어진 곱 정리하기",
          "expression": "a_2a_4=(2r)(2r^3)=4r^4=36",
          "explanation": "a₁=2이므로 a₂=2r, a₄=2r³입니다."
        },
        {
          "title": "공비의 네제곱 구하기",
          "expression": "4r^4=36\\Rightarrow r^4=9",
          "explanation": "양변을 4로 나누면 필요한 r⁴의 값을 바로 얻습니다."
        },
        {
          "title": "항의 비 계산하기",
          "expression": "\\frac{a_7}{a_3}=\\frac{2r^6}{2r^2}=r^4=9",
          "explanation": "두 항의 지수 차가 4이므로 항의 비는 r⁴입니다."
        }
      ],
      "correctReason": "a₇/a₃=9이므로 선지 ⑤가 정답입니다.",
      "commonMistake": "r 자체를 구하려고 양의 공비라고 가정할 필요가 없습니다. 이 문제는 r⁴만 알면 끝납니다.",
      "verification": {
