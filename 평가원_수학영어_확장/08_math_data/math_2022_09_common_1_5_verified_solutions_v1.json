        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
    },
    "2022_09_common_4": {
      "id": "2022_09_common_4",
      "status": "verified_internal_candidate",
      "exam": "2022학년도 9월 모의평가 수학",
      "questionNumber": 4,
      "answer": 4,
      "answerMark": "④",
      "summary": "경계 x=-1에서 왼쪽 식의 함숫값과 오른쪽 식의 극한을 같게 두면 a=4입니다.",
      "approach": "각 조각은 다항함수이므로 경계점 x=-1에서 두 식의 값이 이어지는지만 확인합니다.",
      "concepts": [
        "구간별로 정의된 함수",
        "함수의 연속"
      ],
      "steps": [
        {
          "title": "왼쪽 함숫값 구하기",
          "expression": "f(-1)=2(-1)+a=a-2",
          "explanation": "x=-1은 x≤-1인 첫 번째 식에 포함됩니다."
        },
        {
          "title": "오른쪽 극한 구하기",
          "expression": "\\lim_{x\\to-1+}f(x)=(-1)^2-5(-1)-a=6-a",
          "explanation": "x>-1인 두 번째 식에 -1을 가까이 대입한 값을 계산합니다."
        },
        {
          "title": "연속 조건 풀기",
          "expression": "a-2=6-a\\Rightarrow2a=8\\Rightarrow a=4",
          "explanation": "경계에서 연속이려면 왼쪽 함숫값과 오른쪽 극한이 같아야 합니다."
        }
      ],
      "correctReason": "연속 조건을 만족하는 a가 4이므로 선지 ④가 정답입니다.",
      "commonMistake": "두 번째 식에 x=-1이 포함되지 않아도 오른쪽 극한을 구할 때는 -1을 대입해 경계값을 비교합니다.",
      "verification": {
