    "2023_06_cal_27": {
      "id": "2023_06_cal_27",
      "status": "verified_internal_candidate",
      "exam": "2023학년도 6월 모의평가 수학 미적분",
      "questionNumber": 27,
      "answer": "3",
      "answerMark": "③",
      "summary": "급수의 일반항이 0으로 수렴해야 하므로 공차는 3입니다. 일반항은 1/n-1/(n+2)가 되어 합은 3/2입니다.",
      "approach": "등차수열을 공차 d로 나타내고, 급수 수렴의 필요조건으로 d를 먼저 결정한 뒤 망원급수를 계산합니다.",
      "concepts": [
        "급수 수렴의 필요조건",
        "망원급수"
      ],
      "steps": [
        {
          "title": "등차수열 나타내기",
          "expression": "a_n=4+(n-1)d=dn+4-d",
          "explanation": "첫째항 4와 공차 d를 사용합니다."
        },
        {
          "title": "일반항의 극한으로 공차 구하기",
          "expression": "\\frac{a_n}{n}-\\frac{3n+7}{n+2}=d+\\frac{4-d}{n}-3-\\frac{1}{n+2}",
          "explanation": "급수가 수렴하려면 이 일반항의 극한이 0이어야 하므로 d-3=0, 즉 d=3입니다."
        },
        {
          "title": "망원급수로 바꾸기",
          "expression": "d=3\\Rightarrow\\frac{a_n}{n}-\\frac{3n+7}{n+2}=\\frac1n-\\frac{1}{n+2}",
          "explanation": "a_n=3n+1을 대입하면 앞뒤 항이 차례로 소거되는 꼴입니다."
        },
        {
          "title": "무한합 계산하기",
          "expression": "S=1+\\frac12=\\frac32",
          "explanation": "부분합에서 1과 1/2만 남고 뒤의 두 항은 0으로 수렴합니다."
        }
      ],
      "correctReason": "급수의 합은 3/2이므로 정답은 ③입니다.",
      "commonMistake": "급수의 일반항이 0으로 수렴한다는 조건만 확인하고 끝내지 마세요. 그 조건으로 공차를 정한 뒤 실제 급수의 합까지 계산해야 합니다.",
