    "2023_06_cal_24": {
      "id": "2023_06_cal_24",
      "status": "verified_internal_candidate",
      "exam": "2023학년도 6월 모의평가 수학 미적분",
      "questionNumber": 24,
      "answer": "1",
      "answerMark": "①",
      "summary": "음함수 미분으로 y'를 구한 뒤 (e,e²)를 대입하면 접선의 기울기는 e+1입니다.",
      "approach": "y를 x의 함수로 보고 곡선의 양변을 x에 대하여 미분합니다.",
      "concepts": [
        "음함수 미분",
        "곱의 미분법"
      ],
      "steps": [
        {
          "title": "곡선의 식 미분하기",
          "expression": "2x-\\left(y'\\ln x+\\frac{y}{x}\\right)+1=0",
          "explanation": "y ln x를 미분할 때 y' ln x와 y/x가 함께 생깁니다."
        },
        {
          "title": "y'에 관해 정리하기",
          "expression": "y'=\\frac{2x+1-\\frac{y}{x}}{\\ln x}",
          "explanation": "y'가 포함된 항을 한쪽으로 모읍니다."
        },
        {
          "title": "주어진 점 대입하기",
          "expression": "y'(e)=\\frac{2e+1-e}{1}=e+1",
          "explanation": "y/x=e²/e=e이고 ln e=1입니다."
        }
      ],
      "correctReason": "접선의 기울기는 e+1이므로 정답은 ①입니다.",
      "commonMistake": "y ln x를 y/x만으로 미분하지 마세요. y도 x에 따라 변하므로 y' ln x 항이 필요합니다.",
      "verification": {
