    "2023_06_cal_23": {
      "id": "2023_06_cal_23",
      "status": "verified_internal_candidate",
      "exam": "2023학년도 6월 모의평가 수학 미적분",
      "questionNumber": 23,
      "answer": "1",
      "answerMark": "①",
      "summary": "분모를 유리화하면 두 제곱근의 합을 2n으로 나눈 꼴이 되고, n²을 묶어 극한을 계산하면 1입니다.",
      "approach": "두 제곱근의 차가 있는 분모에 켤레식을 곱해 0/0형을 제거합니다.",
      "concepts": [
        "무리식의 유리화",
        "수열의 극한"
      ],
      "steps": [
        {
          "title": "분모 유리화하기",
          "expression": "\\frac{1}{\\sqrt{n^2+3n}-\\sqrt{n^2+n}}=\\frac{\\sqrt{n^2+3n}+\\sqrt{n^2+n}}{2n}",
          "explanation": "제곱의 차를 이용하면 분모는 (n²+3n)-(n²+n)=2n이 됩니다."
        },
        {
          "title": "n²을 제곱근 밖으로 꺼내기",
          "expression": "\\frac{\\sqrt{1+\\frac3n}+\\sqrt{1+\\frac1n}}{2}",
          "explanation": "n은 양의 정수이므로 각 제곱근에서 n을 꺼내고 약분합니다."
        },
        {
          "title": "극한 계산하기",
          "expression": "\\lim_{n\\to\\infty}\\frac{\\sqrt{1+\\frac3n}+\\sqrt{1+\\frac1n}}{2}=1",
          "explanation": "3/n과 1/n이 모두 0으로 수렴합니다."
        }
      ],
      "correctReason": "분모를 유리화한 뒤 n으로 나누면 극한이 1로 수렴하므로 ①이 정답입니다.",
      "commonMistake": "제곱근의 차를 각각 따로 극한 처리해 0으로 보지 마세요. 두 항의 최고차항이 같아 차이가 작아지므로 먼저 유리화해야 합니다.",
      "verification": {
        "problemPage": 13,
        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
