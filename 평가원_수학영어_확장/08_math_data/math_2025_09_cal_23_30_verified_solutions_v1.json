    "2025_09_cal_23": {
      "id": "2025_09_cal_23",
      "status": "verified_internal_candidate",
      "exam": "2025학년도 9월 모의평가 수학 미적분",
      "questionNumber": 23,
      "answer": "5",
      "answerMark": "⑤",
      "summary": "삼각함수의 기본 극한을 적용하면 극한값은 5입니다.",
      "approach": "분자에 5x를 만들어 sin t/t의 극한으로 바꿉니다.",
      "concepts": ["삼각함수의 극한", "상수배"],
      "steps": [
        {
          "title": "기본형 만들기",
          "expression": "\\frac{\\sin 5x}{x}=5\\cdot\\frac{\\sin 5x}{5x}",
          "explanation": "분모와 분자에 5를 맞추어 기본 극한의 꼴로 정리합니다."
        },
        {
          "title": "극한 적용",
          "expression": "5\\lim_{x\\to0}\\frac{\\sin 5x}{5x}=5",
          "explanation": "5x가 0으로 갈 때 sin(5x)/(5x)는 1로 갑니다."
        }
      ],
      "correctReason": "sin t/t가 1로 수렴하고 바깥의 상수 5가 그대로 남습니다.",
      "commonMistake": "sin 5x를 5 sin x로 바꾸지 마세요. 극한에서만 5x를 한 덩어리로 다룹니다.",
      "verification": {
        "problemPage": 13,
        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
    },
    "2025_09_cal_24": {
      "id": "2025_09_cal_24",
      "status": "verified_internal_candidate",
      "exam": "2025학년도 9월 모의평가 수학 미적분",
      "questionNumber": 24,
      "answer": "4",
      "answerMark": "④",
      "summary": "주어진 접선 기울기를 적분하고 초기값을 적용하면 f(e)=2e^(2e)+2입니다.",
      "approach": "접선의 기울기를 f'(t)로 읽고 부정적분한 뒤 f(1)로 적분상수를 정합니다.",
      "concepts": ["도함수와 접선", "부정적분", "초기조건"],
      "steps": [
        {
          "title": "도함수 확인",
          "expression": "f'(t)=\\frac1t+4e^{2t}",
          "explanation": "곡선 위 점에서의 접선 기울기는 그 점의 도함수 값입니다."
        },
        {
          "title": "적분",
          "expression": "f(t)=\\ln t+2e^{2t}+C",
          "explanation": "양수 t에서 1/t의 원시함수는 ln t입니다."
        },
        {
          "title": "초기값과 대입",
          "expression": "f(1)=2e^2+C=2e^2+1\\Rightarrow C=1,\\quad f(e)=2e^{2e}+2",
          "explanation": "ln e=1까지 더하면 정답은 ④입니다."
        }
      ],
      "correctReason": "적분상수 1과 ln e=1을 모두 반영한 값이 2e^(2e)+2입니다.",
      "commonMistake": "4e^(2t)를 적분할 때 지수의 미분값 2로 나누어 2e^(2t)가 됨을 놓치지 마세요.",
      "verification": {
        "problemPage": 13,
        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
    },
    "2025_09_cal_25": {
      "id": "2025_09_cal_25",
      "status": "verified_internal_candidate",
      "exam": "2025학년도 9월 모의평가 수학 미적분",
      "questionNumber": 25,
      "answer": "4",
      "answerMark": "④",
      "summary": "유한한 양의 극한이 되려면 공비가 1/2이고 첫째항이 3이므로 a1+a2=9/2입니다.",
      "approach": "등비수열의 일반항을 대입한 뒤 분모의 주된 증가율 2^n과 분자의 지수항을 맞춥니다.",
      "concepts": ["등비수열", "지수수열의 극한", "증가율 비교"],
      "steps": [
        {
          "title": "일반항 대입",
          "expression": "a_n=a_1r^{n-1}\\Rightarrow 4^na_n=\\frac{a_1}{r}(4r)^n",
          "explanation": "첫째항과 공비로 분자의 지수항을 나타냅니다."
        },
        {
          "title": "공비 결정",
          "expression": "4r=2\\Rightarrow r=\\frac12",
          "explanation": "분모가 2^n에 비례하므로 극한이 0도 무한대도 아니려면 분자의 밑도 2여야 합니다."
        },
        {
          "title": "첫째항과 합",
          "expression": "\\lim\\frac{2a_1\\,2^n-1}{6\\,2^n}=\\frac{a_1}{3}=1\\Rightarrow a_1=3,\\quad a_1+a_2=3+\\frac32=\\frac92",
          "explanation": "정답은 ④입니다."
        }
      ],
      "correctReason": "공비와 첫째항을 극한 조건에서 차례로 고정하면 합이 유일하게 9/2로 정해집니다.",
      "commonMistake": "-1은 n이 커질 때 주된 항이 아니지만, 공비를 정하기 전에 무조건 버리면 증가율 조건을 놓칠 수 있습니다.",
      "verification": {
        "problemPage": 14,
        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
    },
    "2025_09_cal_27": {
      "id": "2025_09_cal_27",
      "status": "verified_internal_candidate",
      "exam": "2025학년도 9월 모의평가 수학 미적분",
      "questionNumber": 27,
      "answer": "2",
      "answerMark": "②",
      "summary": "함수 방정식을 미분하고 x=0과 x=π를 차례로 대입하면 f'(π)=-2/3입니다.",
      "approach": "합성함수를 미분한 식에서 먼저 f'(0)을 구한 뒤 같은 식에 x=π를 넣습니다.",
      "concepts": ["함수방정식", "합성함수의 미분", "특수각"],
      "steps": [
        {
          "title": "양변 미분",
          "expression": "f'(x)+\\frac12\\cos x\\,f'\\left(\\frac12\\sin x\\right)=\\cos x",
          "explanation": "두 번째 항에는 합성함수의 미분법을 적용합니다."
        },
        {
          "title": "f'(0) 계산",
          "expression": "f'(0)+\\frac12f'(0)=1\\Rightarrow f'(0)=\\frac23",
          "explanation": "sin 0=0, cos 0=1을 사용합니다."
        },
        {
          "title": "f'(π) 계산",
          "expression": "f'(\\pi)-\\frac12f'(0)=-1\\Rightarrow f'(\\pi)=-\\frac23",
          "explanation": "sin π=0, cos π=-1을 사용하면 정답은 ②입니다."
        }
      ],
      "correctReason": "x=π에서도 합성함수 안쪽이 0이므로 앞에서 구한 f'(0)을 재사용할 수 있습니다.",
      "commonMistake": "합성함수를 미분할 때 바깥 함수의 도함수만 쓰고 안쪽 미분값 (1/2)cos x를 빠뜨리지 마세요.",
      "verification": {
