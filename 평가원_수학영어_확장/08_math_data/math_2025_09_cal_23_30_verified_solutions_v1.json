      "answerMark": null,
      "summary": "무한급수를 망원급수로 정리하면 a1=3/2, a10=1/11이므로 p+q=57입니다.",
      "approach": "일반항을 부분분수로 분해해 S_m을 구하고, a_n=S_n-S_(n-1)을 사용합니다.",
      "concepts": ["부분분수", "망원급수", "수열과 부분합"],
      "steps": [
        {
          "title": "부분분수 분해",
          "expression": "\\frac{m+1}{n(n+m+1)}=\\frac1n-\\frac1{n+m+1}",
          "explanation": "무한히 더하면 중간 항들이 서로 지워집니다."
        },
        {
          "title": "부분합 표현",
          "expression": "S_m=1+\\frac12+\\cdots+\\frac1{m+1}",
          "explanation": "앞쪽 m+1개 항만 남습니다."
        },
        {
          "title": "필요한 두 항",
          "expression": "a_1=S_1=\\frac32,\\qquad a_{10}=S_{10}-S_9=\\frac1{11}",
          "explanation": "두 값을 더하면 35/22입니다."
        },
        {
          "title": "정답 계산",
          "expression": "a_1+a_{10}=\\frac{35}{22}=\\frac qp\\Rightarrow p+q=22+35=57",
          "explanation": "35와 22는 서로소입니다."
        }
      ],
      "correctReason": "부분합의 차로 일반항을 복원하면 10번째 항은 새로 추가된 1/11 하나입니다.",
