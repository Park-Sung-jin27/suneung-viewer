      "steps": [
        {
          "title": "점근선 찾기",
          "expression": "y=\\log_2(x-a)\\text{의 점근선은 }x=a",
          "explanation": "로그 안이 0이 되는 세로선이 점근선입니다."
        },
        {
          "title": "교점의 높이 구하기",
          "expression": "y_A=\\log_2\\frac a4=\\log_2a-2,\\qquad y_B=\\log_{1/2}a=-\\log_2a",
