      "answerMark": "②",
      "summary": "구하려는 합을 S라 두면 2S+30=60이므로 S=15입니다.",
      "approach": "합의 선형성을 이용해 주어진 식을 구하려는 합 하나로 정리합니다.",
      "concepts": ["수열의 합", "합의 선형성"],
      "steps": [
        {
          "title": "구하려는 합 두기",
          "expression": "S=\\sum_{k=1}^{10}a_k",
          "explanation": "문제에서 요구한 합을 S로 둡니다."
        },
        {
          "title": "주어진 합 정리하기",
          "expression": "\\sum_{k=1}^{10}(2a_k+3)=2S+3\\times10",
          "explanation": "상수 3은 열 번 더해집니다."
        },
        {
          "title": "S 구하기",
          "expression": "2S+30=60\\Rightarrow S=15",
          "explanation": "일차방정식을 풀어 합을 구합니다."
        }
      ],
      "correctReason": "수열의 합 15가 선지 ②와 일치합니다.",
      "commonMistake": "상수 3을 한 번만 더하지 말고 항의 개수인 10을 곱하세요.",
      "verification": {"problemPage": 1, "answerTablePage": 1, "problemMatchedPdf": true, "choicesMatchedPdf": true, "answerMatchedPdf": true, "independentDerivation": true}
    },
    "2024_06_common_4": {
