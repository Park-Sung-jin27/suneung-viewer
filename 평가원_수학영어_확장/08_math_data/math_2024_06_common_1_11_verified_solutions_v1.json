      "exam": "2024학년도 6월 모의평가 수학 공통",
      "questionNumber": 4,
      "answer": "2",
      "answerMark": "②",
      "summary": "연속이므로 x가 1로 갈 때의 극한은 f(1)이고, f(1)=4-f(1)에서 f(1)=2입니다.",
      "approach": "연속함수의 극한값이 그 점의 함수값과 같다는 성질을 적용합니다.",
      "concepts": ["함수의 연속", "극한과 함수값"],
      "steps": [
        {
          "title": "연속 조건 적용하기",
          "expression": "\\lim_{x\\to1}f(x)=f(1)",
          "explanation": "함수가 실수 전체에서 연속이므로 x=1에서도 연속입니다."
        },
        {
          "title": "주어진 식 바꾸기",
          "expression": "f(1)=4-f(1)",
          "explanation": "극한을 함수값으로 바꿉니다."
        },
        {
          "title": "함수값 구하기",
          "expression": "2f(1)=4\\Rightarrow f(1)=2",
          "explanation": "양변의 f(1)을 한쪽으로 모읍니다."
        }
      ],
      "correctReason": "f(1)=2가 선지 ②와 일치합니다.",
      "commonMistake": "연속 조건을 쓰지 않고 극한과 함수값을 서로 다른 값으로 두지 마세요.",
      "verification": {"problemPage": 2, "answerTablePage": 1, "problemMatchedPdf": true, "choicesMatchedPdf": true, "answerMatchedPdf": true, "independentDerivation": true}
    },
