      "summary": "곱의 미분법을 적용하면 g'(1)=3·2+2·3=12입니다.",
      "approach": "두 함수의 곱을 미분한 뒤 주어진 함수값과 미분값을 대입합니다.",
      "concepts": ["곱의 미분법", "함수값 대입"],
      "steps": [
        {
          "title": "곱 미분하기",
          "expression": "g'(x)=3x^2f(x)+(x^3+1)f'(x)",
          "explanation": "앞 함수의 미분×뒤 함수와 앞 함수×뒤 함수의 미분을 더합니다."
        },
        {
          "title": "x=1 대입하기",
          "expression": "g'(1)=3f(1)+2f'(1)",
          "explanation": "1의 제곱과 세제곱은 모두 1입니다."
        },
        {
          "title": "주어진 값 계산하기",
          "expression": "g'(1)=3\\times2+2\\times3=12",
          "explanation": "f(1)=2, f'(1)=3을 대입합니다."
        }
      ],
      "correctReason": "g'(1)=12가 선지 ①과 일치합니다.",
      "commonMistake": "곱을 미분할 때 두 함수를 각각 미분한 값만 곱하지 마세요.",
      "verification": {"problemPage": 2, "answerTablePage": 1, "problemMatchedPdf": true, "choicesMatchedPdf": true, "answerMatchedPdf": true, "independentDerivation": true}
