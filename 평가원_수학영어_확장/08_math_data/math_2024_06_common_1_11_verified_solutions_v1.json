      "questionNumber": 1,
      "answer": "5",
      "answerMark": "⑤",
      "summary": "세제곱근과 음의 지수를 각각 계산하면 값은 3/2입니다.",
      "approach": "각 인수를 간단한 수로 바꾼 뒤 곱합니다.",
      "concepts": ["거듭제곱", "음의 지수"],
      "steps": [
        {
          "title": "세제곱근 계산하기",
          "expression": "\\sqrt[3]{27}=3",
          "explanation": "3의 세제곱이 27입니다."
        },
        {
          "title": "음의 지수 계산하기",
          "expression": "4^{-\\frac12}=\\frac1{\\sqrt4}=\\frac12",
          "explanation": "지수가 -1/2이면 제곱근의 역수입니다."
        },
        {
          "title": "두 값 곱하기",
          "expression": "3\\times\\frac12=\\frac32",
          "explanation": "최종값은 3/2입니다."
        }
      ],
      "correctReason": "계산값 3/2가 선지 ⑤와 일치합니다.",
      "commonMistake": "4의 -1/2제곱을 -2로 계산하지 말고 제곱근의 역수로 바꾸세요.",
      "verification": {"problemPage": 1, "answerTablePage": 1, "problemMatchedPdf": true, "choicesMatchedPdf": true, "answerMatchedPdf": true, "independentDerivation": true}
    },
    "2024_06_common_2": {
      "id": "2024_06_common_2",
      "status": "verified_internal_candidate",
      "exam": "2024학년도 6월 모의평가 수학 공통",
      "questionNumber": 2,
      "answer": "4",
      "answerMark": "④",
      "summary": "주어진 극한은 x=3에서의 미분계수이므로 값은 f'(3)=4입니다.",
      "approach": "미분계수의 정의를 알아보고 도함수에 x=3을 대입합니다.",
      "concepts": ["미분계수의 정의", "다항함수의 미분"],
      "steps": [
        {
          "title": "극한의 의미 찾기",
          "expression": "\\lim_{h\\to0}\\frac{f(3+h)-f(3)}h=f'(3)",
          "explanation": "미분계수의 정의와 같은 꼴입니다."
        },
        {
          "title": "도함수 구하기",
          "expression": "f'(x)=2x-2",
          "explanation": "이차함수를 항별로 미분합니다."
        },
        {
          "title": "값 계산하기",
          "expression": "f'(3)=6-2=4",
          "explanation": "따라서 극한값은 4입니다."
        }
      ],
      "correctReason": "미분계수 4가 선지 ④와 일치합니다.",
      "commonMistake": "f(3)의 함수값을 묻는 것이 아니라 f'(3)을 묻는 극한입니다.",
      "verification": {"problemPage": 1, "answerTablePage": 1, "problemMatchedPdf": true, "choicesMatchedPdf": true, "answerMatchedPdf": true, "independentDerivation": true}
    },
    "2024_06_common_3": {
