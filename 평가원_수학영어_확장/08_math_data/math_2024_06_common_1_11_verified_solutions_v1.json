        },
        {
          "title": "거리 조건 풀기",
          "expression": "|y_A-y_B|=2\\log_2a-2=4\\Rightarrow a=8",
          "explanation": "a>2이므로 해당 차는 양수입니다."
        }
      ],
      "correctReason": "a=8이 선지 ③과 일치합니다.",
