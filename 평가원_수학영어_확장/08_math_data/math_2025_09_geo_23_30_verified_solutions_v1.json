        },
        {
          "title": "자연수 개수",
          "expression": "n=1,2,3,4,5",
          "explanation": "가능한 자연수는 5개이므로 정답은 ③입니다."
        }
      ],
      "correctReason": "거리 조건에는 접하는 경우도 포함되며, n=6부터는 거리가 6보다 커집니다.",
