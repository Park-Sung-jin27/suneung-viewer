    "2024_09_common_2": {
      "id": "2024_09_common_2",
      "status": "verified_internal_candidate",
      "exam": "2024학년도 9월 모의평가 수학 공통",
      "questionNumber": 2,
      "answer": "3",
      "answerMark": "③",
      "summary": "분자를 인수분해해 x-1을 약분하면 극한값은 3입니다.",
      "approach": "f(1)=1임을 확인한 뒤 미분계수 또는 인수분해로 계산합니다.",
      "concepts": ["함수의 극한", "미분계수"],
      "steps": [
        {
          "title": "분자 정리",
          "expression": "f(x)-1=2x^2-x-1=(2x+1)(x-1)",
          "explanation": "x=1에서 0이 되는 인수 x-1을 분리합니다."
        },
        {
          "title": "공통인수 약분",
          "expression": "\\frac{f(x)-1}{x-1}=2x+1\\quad(x\\ne1)",
          "explanation": "극한 과정에서는 x가 1과 같지 않으므로 약분할 수 있습니다."
        },
        {
          "title": "극한값 계산",
          "expression": "\\lim_{x\\to1}(2x+1)=3",
          "explanation": "x=1을 대입하면 3이므로 정답은 ③입니다."
        }
      ],
      "correctReason": "주어진 극한은 f'(1)과 같고 f'(x)=4x-1이므로 f'(1)=3입니다.",
      "commonMistake": "분모가 0이라고 바로 결론내리지 말고 분자의 x-1 인수를 먼저 약분하세요.",
      "verification": {
        "problemPage": 1,
        "answerTablePage": 1,
        "problemMatchedPdf": true,
        "choicesMatchedPdf": true,
        "answerMatchedPdf": true,
        "independentDerivation": true
      }
    },
    "2024_09_common_3": {
      "id": "2024_09_common_3",
      "status": "verified_internal_candidate",
      "exam": "2024학년도 9월 모의평가 수학 공통",
      "questionNumber": 3,
      "answer": "2",
      "answerMark": "②",
      "summary": "제4사분면의 부호를 반영하면 tan θ는 -√2/2입니다.",
      "approach": "cos 값으로 sin의 크기를 구하고 θ의 범위로 부호를 결정합니다.",
      "concepts": ["삼각함수의 기본관계", "사분면의 부호"],
      "steps": [
        {
          "title": "sin의 크기 계산",
          "expression": "\\sin^2\\theta=1-\\cos^2\\theta=1-\\frac{6}{9}=\\frac13",
          "explanation": "sin²θ+cos²θ=1을 사용합니다."
        },
        {
          "title": "부호 결정",
          "expression": "\\frac{3\\pi}{2}<\\theta<2\\pi\\Rightarrow\\sin\\theta=-\\frac{\\sqrt3}{3}",
          "explanation": "θ는 제4사분면에 있으므로 sin은 음수입니다."
        },
        {
          "title": "tan 계산",
          "expression": "\\tan\\theta=\\frac{\\sin\\theta}{\\cos\\theta}=-\\frac{\\sqrt2}{2}",
          "explanation": "계산값은 ②와 일치합니다."
        }
      ],
      "correctReason": "제4사분면에서 cos은 양수이고 sin과 tan은 음수입니다.",
      "commonMistake": "sin의 제곱근을 구한 뒤 θ의 범위를 무시해 양수로 두지 마세요.",
