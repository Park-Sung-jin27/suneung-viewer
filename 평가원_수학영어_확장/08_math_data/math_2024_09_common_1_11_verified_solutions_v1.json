    "2024_09_common_1": {
      "id": "2024_09_common_1",
      "status": "verified_internal_candidate",
      "exam": "2024학년도 9월 모의평가 수학 공통",
      "questionNumber": 1,
      "answer": "5",
      "answerMark": "⑤",
      "summary": "같은 밑의 거듭제곱을 곱할 때 지수를 더하면 값은 9입니다.",
      "approach": "두 지수의 합에서 무리수 항이 소거되는지 먼저 확인합니다.",
      "concepts": ["거듭제곱의 곱", "지수법칙"],
      "steps": [
        {
          "title": "지수 합치기",
          "expression": "3^{1-\\sqrt5}\\times3^{1+\\sqrt5}=3^{(1-\\sqrt5)+(1+\\sqrt5)}",
          "explanation": "밑이 모두 3이므로 지수를 더합니다."
        },
        {
          "title": "무리수 항 소거",
          "expression": "(1-\\sqrt5)+(1+\\sqrt5)=2",
          "explanation": "-√5와 +√5가 서로 없어집니다."
        },
        {
          "title": "최종 계산",
          "expression": "3^2=9",
          "explanation": "계산값 9는 ⑤와 일치합니다."
        }
      ],
      "correctReason": "지수법칙을 적용하면 밑이 3이고 지수가 2인 수가 남습니다.",
      "commonMistake": "각 거듭제곱을 따로 근삿값으로 계산하지 말고 지수부터 합치세요.",
      "verification": {
