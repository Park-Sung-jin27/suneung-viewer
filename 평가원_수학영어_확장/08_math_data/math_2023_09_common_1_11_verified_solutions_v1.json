      "answerMark": "⑤",
      "summary": "Sₖ-aₖ=Sₖ₋₁이므로 합은 S₁부터 S₉까지의 망원합 9/10입니다.",
      "approach": "aₖ=Sₖ-Sₖ₋₁ 관계로 식을 바꾼 뒤 부분분수로 합을 계산합니다.",
      "concepts": ["수열의 합과 일반항", "망원합"],
      "steps": [
        {
          "title": "Sₖ-aₖ 정리하기",
          "expression": "S_1-a_1=0,\\qquad S_k-a_k=S_{k-1}\\ (k\\ge2)",
          "explanation": "aₖ=Sₖ-Sₖ₋₁을 이용합니다."
        },
        {
          "title": "합의 범위 바꾸기",
          "expression": "\\sum_{k=1}^{10}(S_k-a_k)=\\sum_{j=1}^{9}S_j",
          "explanation": "첫 항은 0이고 나머지는 S₁부터 S₉까지 한 칸씩 이동합니다."
        },
        {
          "title": "망원합 계산하기",
          "expression": "\\sum_{j=1}^{9}\\frac1{j(j+1)}=\\sum_{j=1}^{9}\\left(\\frac1j-\\frac1{j+1}\\right)=\\frac9{10}",
          "explanation": "중간 항들이 서로 소거됩니다."
        }
      ],
      "correctReason": "합 9/10이 선지 ⑤와 일치합니다.",
      "commonMistake": "k=1에서는 S₀를 임의로 넣지 말고 S₁-a₁=0을 따로 확인하세요.",
      "verification": {"problemPage": 2, "answerTablePage": 1, "problemMatchedPdf": true, "choicesMatchedPdf": true, "answerMatchedPdf": true, "independentDerivation": true}
    },
