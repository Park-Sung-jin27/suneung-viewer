      "answerMark": "③",
      "summary": "첫째항을 A, 공차를 d라 두면 A=-8d이고 2A+18d=-6이므로 d=-3, a₂=21입니다.",
      "approach": "등차수열의 일반항으로 두 조건을 연립합니다.",
      "concepts": ["등차수열의 일반항", "연립방정식"],
      "steps": [
        {
          "title": "첫 번째 조건 정리하기",
          "expression": "A=2(A+4d)\\Rightarrow A=-8d",
          "explanation": "a₅=A+4d를 대입합니다."
        },
        {
          "title": "두 번째 조건 적용하기",
          "expression": "(A+7d)+(A+11d)=-6",
          "explanation": "a₈과 a₁₂를 일반항으로 바꿉니다."
        },
        {
          "title": "a₂ 계산하기",
          "expression": "2(-8d)+18d=-6\\Rightarrow d=-3,\\quad a_2=A+d=21",
          "explanation": "A=24이므로 둘째항은 21입니다."
        }
      ],
      "correctReason": "a₂=21이 선지 ③과 일치합니다.",
      "commonMistake": "a₈의 공차 배수는 8d가 아니라 7d입니다.",
      "verification": {"problemPage": 2, "answerTablePage": 1, "problemMatchedPdf": true, "choicesMatchedPdf": true, "answerMatchedPdf": true, "independentDerivation": true}
    },
