      "questionNumber": 4,
      "answer": "1",
      "answerMark": "①",
      "summary": "경계 x=a에서 두 식의 값이 같아야 하므로 a²+a-6=0이고, 두 해의 합은 -1입니다.",
      "approach": "조각함수의 식이 바뀌는 한 점에서 좌우 값을 같게 둡니다.",
      "concepts": ["함수의 연속", "이차방정식의 근과 계수"],
      "steps": [
        {
          "title": "경계의 왼쪽 값 구하기",
          "expression": "f(a)=-2a+a=-a",
          "explanation": "x=a는 첫 번째 식에 포함됩니다."
        },
        {
          "title": "오른쪽 극한과 같게 두기",
          "expression": "-a=a^2-6\\Rightarrow a^2+a-6=0",
          "explanation": "연속이려면 경계에서 두 식의 값이 같아야 합니다."
        },
        {
          "title": "모든 a의 합 구하기",
          "expression": "a=2,-3\\Rightarrow2+(-3)=-1",
          "explanation": "두 해가 모두 연속 조건을 만족합니다."
        }
      ],
      "correctReason": "가능한 모든 a의 합 -1이 선지 ①과 일치합니다.",
      "commonMistake": "경계값에 x가 아니라 a를 대입해야 하며, 가능한 두 해를 모두 더해야 합니다.",
      "verification": {"problemPage": 2, "answerTablePage": 1, "problemMatchedPdf": true, "choicesMatchedPdf": true, "answerMatchedPdf": true, "independentDerivation": true}
    },
    "2023_09_common_5": {
