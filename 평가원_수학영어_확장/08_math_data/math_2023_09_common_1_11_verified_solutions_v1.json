  "items": {
    "2023_09_common_1": {
      "id": "2023_09_common_1",
      "status": "verified_internal_candidate",
      "exam": "2023학년도 9월 모의평가 수학 공통",
      "questionNumber": 1,
      "answer": "4",
      "answerMark": "④",
      "summary": "밑이 같은 거듭제곱으로 정리하면 지수는 (√3-1)(√3+1)=2가 되어 값은 4입니다.",
      "approach": "분수를 먼저 2의 거듭제곱 하나로 합친 뒤 지수법칙을 적용합니다.",
      "concepts": ["지수법칙", "합차 공식"],
      "steps": [
        {
          "title": "밑 통일하기",
          "expression": "\\frac{2^{\\sqrt3}}2=2^{\\sqrt3-1}",
          "explanation": "나눗셈은 같은 밑의 지수끼리 빼서 정리합니다."
        },
        {
          "title": "지수 곱 계산하기",
          "expression": "(\\sqrt3-1)(\\sqrt3+1)=3-1=2",
          "explanation": "합차 공식으로 무리수가 사라집니다."
        },
        {
          "title": "값 구하기",
          "expression": "(2^{\\sqrt3-1})^{\\sqrt3+1}=2^2=4",
          "explanation": "거듭제곱의 거듭제곱은 지수를 곱합니다."
        }
      ],
      "correctReason": "계산값 4가 선지 ④와 일치합니다.",
      "commonMistake": "분모의 2를 지수에서 빼지 않고 2의 계수처럼 처리하지 마세요.",
      "verification": {"problemPage": 1, "answerTablePage": 1, "problemMatchedPdf": true, "choicesMatchedPdf": true, "answerMatchedPdf": true, "independentDerivation": true}
    },
    "2023_09_common_2": {
      "id": "2023_09_common_2",
      "status": "verified_internal_candidate",
      "exam": "2023학년도 9월 모의평가 수학 공통",
      "questionNumber": 2,
      "answer": "1",
      "answerMark": "①",
      "summary": "주어진 극한은 x=2에서의 미분계수이므로 f'(2)=8입니다.",
      "approach": "미분계수의 정의를 바로 알아보고 도함수를 이용합니다.",
      "concepts": ["미분계수의 정의", "다항함수의 미분"],
      "steps": [
        {
          "title": "극한의 의미 찾기",
          "expression": "\\lim_{x\\to2}\\frac{f(x)-f(2)}{x-2}=f'(2)",
          "explanation": "분자와 분모가 미분계수의 정의와 정확히 같습니다."
        },
        {
          "title": "도함수 구하기",
          "expression": "f'(x)=4x",
          "explanation": "상수 5의 미분값은 0입니다."
        },
        {
          "title": "x=2 대입하기",
          "expression": "f'(2)=8",
          "explanation": "따라서 극한값은 8입니다."
        }
      ],
      "correctReason": "극한값 8이 선지 ①과 일치합니다.",
      "commonMistake": "f(2)를 계산하는 문제가 아니라 f'(2)를 계산하는 문제입니다.",
      "verification": {"problemPage": 1, "answerTablePage": 1, "problemMatchedPdf": true, "choicesMatchedPdf": true, "answerMatchedPdf": true, "independentDerivation": true}
    },
    "2023_09_common_3": {
      "id": "2023_09_common_3",
      "status": "verified_internal_candidate",
      "exam": "2023학년도 9월 모의평가 수학 공통",
      "questionNumber": 3,
      "answer": "2",
      "answerMark": "②",
      "summary": "sinθ=5/13이고 cosθ<0이므로 cosθ=-12/13, 따라서 tanθ=-5/12입니다.",
      "approach": "보각의 사인값을 원래 각의 사인값으로 바꾸고 부호 조건을 적용합니다.",
      "concepts": ["삼각함수의 보각", "삼각함수의 부호"],
      "steps": [
        {
          "title": "사인값 바꾸기",
          "expression": "\\sin(\\pi-\\theta)=\\sin\\theta=\\frac5{13}",
          "explanation": "보각의 사인값은 같습니다."
        },
        {
          "title": "코사인값 구하기",
          "expression": "\\cos\\theta=-\\sqrt{1-\\frac{25}{169}}=-\\frac{12}{13}",
          "explanation": "문제의 cosθ<0 조건 때문에 음의 값을 선택합니다."
        },
        {
          "title": "탄젠트 계산하기",
          "expression": "\\tan\\theta=\\frac{\\sin\\theta}{\\cos\\theta}=-\\frac5{12}",
          "explanation": "사인값을 코사인값으로 나눕니다."
        }
      ],
      "correctReason": "tanθ=-5/12가 선지 ②와 일치합니다.",
      "commonMistake": "제곱 관계로 cosθ의 크기만 구한 뒤, cosθ<0 조건을 빠뜨리지 마세요.",
      "verification": {"problemPage": 1, "answerTablePage": 1, "problemMatchedPdf": true, "choicesMatchedPdf": true, "answerMatchedPdf": true, "independentDerivation": true}
    },
    "2023_09_common_4": {
