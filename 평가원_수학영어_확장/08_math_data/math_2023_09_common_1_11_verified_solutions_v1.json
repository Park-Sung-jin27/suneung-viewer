      "steps": [
        {
          "title": "도함수 인수분해하기",
          "expression": "f'(x)=3x^2-6x=3x(x-2)",
          "explanation": "임계점은 x=0과 x=2입니다."
        },
        {
          "title": "극대값으로 k 구하기",
          "expression": "f(0)=k=9",
          "explanation": "도함수의 부호가 +에서 -로 바뀌는 x=0이 극대점입니다."
