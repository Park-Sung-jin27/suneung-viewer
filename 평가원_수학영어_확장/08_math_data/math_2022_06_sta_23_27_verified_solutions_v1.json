    "2022_06_sta_25": {
      "id": "2022_06_sta_25",
      "status": "verified_internal_candidate",
      "exam": "2022학년도 6월 모의평가 수학 확률과 통계",
      "questionNumber": 25,
      "answer": 3,
      "answerMark": "③",
      "summary": "전체 625개 중 천의 자리가 4·5인 250개와 35로 시작하는 25개가 조건을 만족해 확률은 11/25입니다.",
      "approach": "3500보다 큰 경우를 천의 자리부터 비교해 겹치지 않는 두 경우로 나눕니다.",
      "concepts": [
        "중복순열",
        "경우의 수",
        "확률"
      ],
      "steps": [
        {
          "title": "전체 경우의 수 구하기",
          "expression": "5^4=625",
          "explanation": "네 자리마다 1부터 5까지 다섯 숫자를 중복해 선택할 수 있습니다."
        },
        {
          "title": "천의 자리가 4 또는 5인 경우",
          "expression": "2\\cdot5^3=250",
          "explanation": "천의 자리가 4나 5이면 뒤의 세 자리와 관계없이 3500보다 큽니다."
        },
        {
          "title": "35로 시작하는 경우",
          "expression": "1\\cdot1\\cdot5^2=25",
          "explanation": "천의 자리가 3이면 백의 자리가 5여야 하며, 가능한 35xy는 모두 3500보다 큽니다."
        },
        {
          "title": "확률 약분하기",
          "expression": "\\frac{250+25}{625}=\\frac{275}{625}=\\frac{11}{25}",
          "explanation": "두 경우는 서로 겹치지 않으므로 더한 뒤 전체 경우로 나눕니다."
        }
      ],
      "correctReason": "확률이 11/25이므로 선지 ③이 정답입니다.",
      "commonMistake": "3500 자체는 만들 수 없지만, 3511부터 시작하는 모든 35xy는 3500보다 크므로 25개를 모두 포함해야 합니다.",
