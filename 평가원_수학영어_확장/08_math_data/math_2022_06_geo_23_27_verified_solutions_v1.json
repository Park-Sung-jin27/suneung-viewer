      "exam": "2022학년도 6월 모의평가 수학 기하",
      "questionNumber": 27,
      "answer": 3,
      "answerMark": "③",
      "summary": "접선의 두 절편으로 넓이비를 식으로 만들면 k=ab/6이고, 쌍곡선 조건을 함께 풀어 a²=12를 얻습니다.",
      "approach": "점 P에서의 접선 방정식으로 Q와 R의 좌표를 구하고, 두 삼각형 넓이비와 P의 쌍곡선 조건을 연립합니다.",
      "concepts": [
        "쌍곡선",
        "접선의 방정식",
        "삼각형 넓이비"
      ],
      "steps": [
        {
          "title": "접선과 절편 구하기",
          "expression": "\\frac{4x}{a^2}-\\frac{ky}{b^2}=1,\\quad Q=(\\tfrac{a^2}{4},0),\\quad R=(0,-\\tfrac{b^2}{k})",
          "explanation": "쌍곡선 위의 점 P=(4,k)에서의 접선 공식을 사용합니다."
        },
        {
          "title": "넓이비 적용하기",
          "expression": "[OPQ]=\\frac{a^2b^2}{8k},\\quad[OPS]=2k,\\quad\\frac{[OPQ]}{[OPS]}=\\frac94",
          "explanation": "각 삼각형의 밑변과 높이를 좌표로 계산하면 a²b²/k²=36, 즉 k=ab/6입니다."
        },
        {
          "title": "쌍곡선 위의 점 조건 적용하기",
          "expression": "\\frac{16}{a^2}-\\frac{k^2}{b^2}=1\\quad\u2192\\quad\\frac{16}{a^2}-\\frac{a^2}{36}=1",
          "explanation": "k=ab/6을 점 P의 쌍곡선 방정식에 대입합니다."
        },
        {
          "title": "주축의 길이 구하기",
          "expression": "a^4+36a^2-576=0\\quad\u2192\\quad a^2=12\\quad\u2192\\quad2a=4\\sqrt3",
          "explanation": "a>0이므로 a=2√3이고 주축의 길이는 2a입니다."
        }
      ],
      "correctReason": "주축의 길이가 4√3이므로 선택지 ③이 정답입니다.",
      "commonMistake": "삼각형 OPS의 밑변 OS=4와 높이 k를 사용하면 넓이는 2k이며, 4k가 아닙니다.",
