    "2023_csat_20": [
      {
        "num": 1,
        "mark": "①",
        "text": "성공적인 삶을 위해 미래에 대한 구체적인 계획을 세워야 한다."
      },
      {
        "num": 2,
        "mark": "②",
        "text": "중요한 결정을 내릴 때에는 자신의 직관에 따라 판단해야 한다."
      },
      {
        "num": 3,
        "mark": "③",
        "text": "더 나은 선택을 위해 성공 가능성을 확률적으로 분석해야 한다."
      },
      {
        "num": 4,
        "mark": "④",
        "text": "빠른 목표 달성을 위해 지름길로 가고자 할 때 신중해야 한다."
      },
      {
        "num": 5,
        "mark": "⑤",
        "text": "인생의 여정에서 선택에 따른 결과를 스스로 책임져야 한다."
      }
    ],
    "2023_csat_24": [
      {
        "num": 1,
        "mark": "①",
        "text": "Visual Systems Never Betray Our Trust!"
      },
